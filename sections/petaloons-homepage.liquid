.phm-section-sub { font-size:16px; color:#666; max-width:560px; margin:0 auto; }
.phm-sub--muted { color:rgba(255,255,255,.6); }

/* ── Buttons ── */
.phm-btn { display:inline-flex; align-items:center; gap:8px; font-size:14px; font-weight:700; padding:12px 26px; border-radius:50px; text-decoration:none; transition:transform .18s,box-shadow .18s,background .18s; border:none; cursor:pointer; font-family:inherit; white-space:nowrap; }
.phm-btn:hover { transform:translateY(-2px); outline:none; }
.phm-btn--amber { background:#fea910; color:#121212; box-shadow:0 4px 20px rgba(254,169,16,.3); }
.phm-btn--amber:hover { background:#ffbe3d; box-shadow:0 8px 28px rgba(254,169,16,.45); }
.phm-btn--primary { background:#334fb4; color:#fff; box-shadow:0 4px 18px rgba(51,79,180,.3); }
.phm-btn--primary:hover { background:#2d45a0; box-shadow:0 8px 24px rgba(51,79,180,.4); }
.phm-btn--white { background:#fff; color:#121212; box-shadow:0 2px 12px rgba(0,0,0,.08); }
.phm-btn--white:hover { box-shadow:0 6px 20px rgba(0,0,0,.14); }
.phm-btn--outline { background:#fff; color:#121212; border:2px solid #ddd; }
.phm-btn--outline:hover { border-color:#121212; }
.phm-btn--ghost { background:transparent; color:#fff; border:2px solid rgba(255,255,255,.4); }
.phm-btn--ghost:hover { border-color:#fff; background:rgba(255,255,255,.08); }
.phm-btn--lg { font-size:16px; padding:15px 34px; }

/* ── HERO (Orange/Saffron Theme) ── */
.phm-hero { position:relative; background:linear-gradient(140deg,#6b2200 0%,#b84500 28%,#de7200 58%,#fea910 82%,#ffd438 100%); color:#fff; padding:76px 24px 90px; overflow:hidden; }
.phm-hero__glow { position:absolute; border-radius:50%; pointer-events:none; }
.phm-hero__glow--tl { width:700px; height:700px; top:-280px; left:-200px; background:radial-gradient(circle,rgba(255,255,255,.10) 0%,transparent 65%); }
.phm-hero__glow--br { width:500px; height:500px; bottom:-200px; right:-150px; background:radial-gradient(circle,rgba(255,255,255,.07) 0%,transparent 65%); }
.phm-hero__pattern { position:absolute; inset:0; pointer-events:none; z-index:0; }
.phm-hero__inner { position:relative; z-index:2; max-width:1180px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; }
.phm-hero__content { display:flex; flex-direction:column; gap:0; }
/* Badges */
.phm-hero__badges { display:flex; flex-wrap:wrap; gap:10px; margin-bottom:22px; }
.phm-badge { display:inline-flex; align-items:center; gap:6px; font-size:12.5px; font-weight:600; padding:6px 14px; border-radius:40px; }
.phm-badge__dot { width:7px; height:7px; border-radius:50%; background:currentColor; animation:phm-pulse 2s infinite; }
@keyframes phm-pulse { 0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)} }
.phm-badge--frosted { background:rgba(0,0,0,.22); color:#fff; border:1px solid rgba(255,255,255,.28); backdrop-filter:blur(8px); }
.phm-badge--gold    { background:rgba(255,220,50,.25); color:#fff8c0; border:1px solid rgba(255,220,50,.45); }
/* Title */
.phm-hero__title { font-size:clamp(38px,5.5vw,72px); font-weight:900; line-height:1.0; letter-spacing:-.03em; margin:0 0 16px; color:#fff; text-shadow:0 3px 24px rgba(0,0,0,.25); }
.phm-hero__title-shine { display:block; background:linear-gradient(90deg,#fff8c0,#ffe870,#fff); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
/* Subtitle */
.phm-hero__sub { font-size:clamp(15px,2vw,18px); color:rgba(255,255,255,.88); margin:0 0 26px; line-height:1.65; max-width:480px; }
/* Keyword pills */
.phm-hero__kw-row { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:30px; }
.phm-hero__kw-pill { background:rgba(0,0,0,.22); color:#fff; padding:7px 16px; border-radius:50px; font-size:13px; font-weight:700; text-decoration:none; border:1.5px solid rgba(255,255,255,.32); backdrop-filter:blur(6px); transition:background .18s,border-color .18s; }
.phm-hero__kw-pill:hover { background:rgba(0,0,0,.38); border-color:rgba(255,255,255,.6); }
/* CTAs */
.phm-hero__ctas { display:flex; gap:14px; flex-wrap:wrap; margin-bottom:30px; }
.phm-btn--hero-primary { background:#fff; color:#9a3500; font-weight:800; font-size:15px; padding:14px 34px; border-radius:50px; text-decoration:none; box-shadow:0 10px 32px rgba(0,0,0,.22); transition:transform .18s,box-shadow .18s; display:inline-flex; align-items:center; gap:7px; }
.phm-btn--hero-primary:hover { transform:translateY(-3px); box-shadow:0 16px 40px rgba(0,0,0,.3); background:#fff8f0; }
.phm-btn--hero-secondary { background:rgba(0,0,0,.22); color:#fff; font-weight:700; font-size:15px; padding:14px 28px; border-radius:50px; text-decoration:none; border:2px solid rgba(255,255,255,.38); backdrop-filter:blur(6px); transition:background .18s,border-color .18s; display:inline-flex; align-items:center; }
.phm-btn--hero-secondary:hover { background:rgba(0,0,0,.38); border-color:#fff; }
/* Trust */
.phm-hero__trust { display:flex; gap:18px; flex-wrap:wrap; }
.phm-trust-item { font-size:13px; color:rgba(255,255,255,.72); display:flex; align-items:center; gap:5px; }
.phm-trust-item span { color:#fff; font-weight:800; }

/* ── HERO PRODUCT SHOWCASE ── */
.phm-hero__showcase { position:relative; display:grid; grid-template-columns:1.1fr 0.9fr; gap:14px; align-items:start; }
.phm-hero__showcase-side { display:flex; flex-direction:column; gap:14px; }
/* Product cards */
.phm-hpc { display:block; border-radius:20px; overflow:hidden; background:#fff; text-decoration:none; box-shadow:0 20px 54px rgba(0,0,0,.28); border:3px solid rgba(255,255,255,.75); transition:transform .28s ease,box-shadow .28s ease; position:relative; }
.phm-hpc:hover { box-shadow:0 28px 66px rgba(0,0,0,.35); }
.phm-hpc--lehenga { transform:rotate(-2.5deg); }
.phm-hpc--lehenga:hover { transform:rotate(0deg) scale(1.03) translateY(-5px); }
.phm-hpc--sherwani { transform:rotate(2deg); }
.phm-hpc--sherwani:hover { transform:rotate(0deg) scale(1.03) translateY(-5px); }
.phm-hpc--tshirt { transform:rotate(-1.5deg); }
.phm-hpc--tshirt:hover { transform:rotate(0deg) scale(1.03) translateY(-5px); }
.phm-hpc__img-wrap { width:100%; overflow:hidden; display:flex; align-items:center; justify-content:center; }
.phm-hpc__img-wrap img { width:100%; height:100%; object-fit:contain; object-position:center bottom; display:block; transition:transform .4s ease; }
.phm-hpc:hover .phm-hpc__img-wrap img { transform:scale(1.04); }
.phm-hpc--lehenga .phm-hpc__img-wrap { height:340px; background:linear-gradient(160deg,#fff5ee,#ffeedd); }
.phm-hpc--sherwani .phm-hpc__img-wrap { height:230px; background:linear-gradient(160deg,#f5f0ff,#ede0ff); }
.phm-hpc--tshirt .phm-hpc__img-wrap { height:190px; background:linear-gradient(160deg,#f0f7ff,#e0efff); }
.phm-hpc__label { display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:#fff; }
.phm-hpc__cat { font-size:13px; font-weight:700; color:#333; }
.phm-hpc__cta { font-size:12px; font-weight:800; color:#b84500; }
/* Floating pills */
.phm-hero__fpill { position:absolute; background:#fff; border-radius:50px; display:flex; align-items:center; gap:8px; font-size:13px; font-weight:700; color:#121212; box-shadow:0 8px 28px rgba(0,0,0,.18); white-space:nowrap; z-index:10; }
.phm-hero__fpill--rating { bottom:-14px; left:-16px; padding:10px 16px; }
.phm-hero__fstars { color:#fea910; font-size:14px; letter-spacing:1px; }
.phm-hero__fnew { position:absolute; top:-14px; right:-8px; background:linear-gradient(135deg,#ffe566,#fea910); color:#6b2200; font-size:11px; font-weight:900; line-height:1.45; text-align:center; padding:10px 14px; border-radius:14px; box-shadow:0 6px 20px rgba(254,169,16,.55); border:2px solid rgba(255,255,255,.75); z-index:10; }

/* ── STATS BAR ── */
.phm-stats-bar { background:#fff; border-bottom:1px solid #ede8e0; padding:24px 0; }
.phm-stats-bar__inner { max-width:1000px; margin:0 auto; padding:0 24px; display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:16px 28px; }
.phm-stat { display:flex; flex-direction:column; align-items:center; gap:2px; text-align:center; }
.phm-stat strong { font-size:22px; font-weight:800; color:#121212; }
.phm-stat span { font-size:12px; color:#888; text-transform:uppercase; letter-spacing:.05em; }
.phm-stat__div { width:1px; height:32px; background:#e8e8e0; }

/* ── OCCASIONS ── */
.phm-occasions { background:#f7f5f2; padding:72px 0 80px; }
.phm-occasions__grid { display:grid; grid-template-columns:repeat(7,1fr); gap:14px; }
.phm-occ-card { display:flex; flex-direction:column; align-items:center; gap:8px; padding:28px 16px; border-radius:18px; text-decoration:none; color:#121212; border:1.5px solid transparent; text-align:center; transition:transform .2s,box-shadow .2s,border-color .2s; }
.phm-occ-card:hover { transform:translateY(-5px); box-shadow:0 10px 30px rgba(0,0,0,.09); }
.phm-occ-card__icon { font-size:30px; }
.phm-occ-card strong { font-size:14px; font-weight:700; }
.phm-occ-card span { font-size:12px; color:#888; }
.phm-occ-card--1 { background:linear-gradient(135deg,#fdf4ff,#fff); border-color:#e9d5ff; }
.phm-occ-card--2 { background:linear-gradient(135deg,#fffbeb,#fff); border-color:#fde68a; }
.phm-occ-card--3 { background:linear-gradient(135deg,#fdf2f8,#fff); border-color:#fbcfe8; }
.phm-occ-card--4 { background:linear-gradient(135deg,#eff6ff,#fff); border-color:#bfdbfe; }
.phm-occ-card--5 { background:linear-gradient(135deg,#f0fdf4,#fff); border-color:#bbf7d0; }
.phm-occ-card--6 { background:linear-gradient(135deg,#fff7ed,#fff); border-color:#fed7aa; }

/* ── COLLECTION SECTIONS ── */
.phm-collection-section { padding:80px 0; }
.phm-section--light { background:#fff; }
.phm-section--dark { background:linear-gradient(135deg,#0f1117 0%,#1a2238 100%); }
.phm-collection-hd { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; margin-bottom:40px; flex-wrap:wrap; }
.phm-collection-hd--dark .phm-section-sub { color:rgba(255,255,255,.6); }
.phm-view-all { flex-shrink:0; }
.phm-collection-cta { text-align:center; margin-top:44px; }

/* ── PRODUCT GRID ── */
.phm-prod-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
.phm-prod-card { background:#fff; border:1.5px solid #ede8e0; border-radius:18px; overflow:hidden; display:flex; flex-direction:column; transition:transform .22s,box-shadow .22s,border-color .22s; }
.phm-prod-card:hover { transform:translateY(-6px); box-shadow:0 14px 44px rgba(0,0,0,.1); border-color:#c7d9ff; }
.phm-prod-card__img-wrap { position:relative; display:block; aspect-ratio:3/4; overflow:hidden; background:#f7f5f2; }
.phm-prod-card__img { width:100%; height:100%; object-fit:cover; transition:transform .45s ease; }
.phm-prod-card:hover .phm-prod-card__img { transform:scale(1.07); }
.phm-prod-card__placeholder { width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:48px; background:linear-gradient(135deg,#ede8e0,#f7f5f2); }
.phm-prod-card__badge { position:absolute; top:12px; left:12px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; padding:4px 10px; border-radius:20px; }
.phm-prod-card__badge--best { background:#fea910; color:#121212; }
.phm-prod-card__badge--sale { background:#ef4444; color:#fff; }
.phm-prod-card__badge--new  { background:#334fb4; color:#fff; }
.phm-prod-card__body { padding:16px; display:flex; flex-direction:column; gap:8px; flex:1; }
.phm-prod-card__title { font-size:14px; font-weight:700; line-height:1.3; margin:0; color:#121212; }
.phm-prod-card__title a { color:inherit; text-decoration:none; }
.phm-prod-card__title a:hover { color:#334fb4; }
.phm-prod-card__price { font-size:15px; font-weight:800; color:#121212; }
.phm-prod-card__compare { font-size:13px; color:#aaa; text-decoration:line-through; margin-left:6px; font-weight:400; }
.phm-prod-card__btn { display:block; width:100%; padding:10px; background:#121212; color:#fff; font-size:13px; font-weight:700; border-radius:10px; text-align:center; text-decoration:none; margin-top:auto; transition:background .18s; }
.phm-prod-card__btn:hover { background:#334fb4; color:#fff; }
.phm-empty { grid-column:1/-1; color:#aaa; padding:40px; text-align:center; }

/* ── WHY PETALOONS ── */
.phm-why { background:linear-gradient(135deg,#0f1117 0%,#1a2238 100%); padding:80px 0; }
.phm-why__grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
.phm-why-card { background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1); border-radius:18px; padding:28px 22px; text-align:center; transition:background .2s; }
.phm-why-card:hover { background:rgba(255,255,255,.1); }
.phm-why-card__icon { font-size:32px; margin-bottom:14px; }
.phm-why-card h3 { font-size:16px; font-weight:700; color:#fff; margin:0 0 10px; }
.phm-why-card p { font-size:13.5px; color:rgba(255,255,255,.55); margin:0; line-height:1.6; }

/* ── REVIEWS ── */
.phm-reviews { background:#f7f5f2; padding:80px 0; }
.phm-rating-summary { display:flex; align-items:center; gap:10px; justify-content:center; margin-top:12px; flex-wrap:wrap; }
.phm-rating-stars { color:#fea910; font-size:20px; letter-spacing:2px; }
.phm-rating-count { font-size:13px; color:#888; }
.phm-reviews__grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
.phm-review { background:#fff; border-radius:18px; padding:28px 24px; border:1px solid #ede8e0; display:flex; flex-direction:column; gap:14px; position:relative; }
.phm-review--featured { background:#121212; border-color:transparent; color:#fff; transform:scale(1.03); box-shadow:0 14px 44px rgba(0,0,0,.18); }
.phm-review__badge { position:absolute; top:-12px; left:24px; background:#fea910; color:#121212; font-size:11px; font-weight:700; padding:3px 12px; border-radius:20px; }
.phm-review__stars { color:#fea910; font-size:16px; letter-spacing:2px; }
.phm-review__text { font-size:14.5px; line-height:1.7; margin:0; flex:1; }
.phm-review--featured .phm-review__text { color:rgba(255,255,255,.8); }
.phm-review__author { display:flex; align-items:center; gap:12px; }
.phm-review__avatar { width:38px; height:38px; border-radius:50%; background:#334fb4; color:#fff; font-size:15px; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.phm-review--featured .phm-review__avatar { background:#fea910; color:#121212; }
.phm-review__author strong { font-size:14px; display:block; color:#121212; }
.phm-review--featured .phm-review__author strong { color:#fff; }
.phm-review__author span { font-size:12px; color:#888; }
.phm-review--featured .phm-review__author span { color:rgba(255,255,255,.5); }
.phm-review__product { font-size:12px; color:#aaa; padding-top:10px; border-top:1px solid #f0ece6; }
.phm-review__product a { color:#334fb4; text-decoration:none; }
.phm-review--featured .phm-review__product { border-top-color:rgba(255,255,255,.1); }
.phm-review--featured .phm-review__product a { color:#fea910; }

/* ── BLOG PREVIEW ── */
.phm-blog-preview { background:#fff; padding:80px 0; border-top:1px solid #ede8e0; }
.phm-blog-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
.phm-blog-card { border:1px solid #ede8e0; border-radius:18px; overflow:hidden; transition:transform .22s,box-shadow .22s; }
.phm-blog-card:hover { transform:translateY(-5px); box-shadow:0 12px 36px rgba(0,0,0,.09); }
.phm-blog-card__img-wrap { display:block; aspect-ratio:16/9; overflow:hidden; background:#f7f5f2; }
.phm-blog-card__img { width:100%; height:100%; object-fit:cover; transition:transform .4s; }
.phm-blog-card:hover .phm-blog-card__img { transform:scale(1.05); }
.phm-blog-card__placeholder { width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:40px; background:linear-gradient(135deg,#334fb4,#7c3aed); }
.phm-blog-card__body { padding:20px; display:flex; flex-direction:column; gap:8px; }
.phm-blog-card__tag { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:#334fb4; }
.phm-blog-card__title { font-size:16px; font-weight:700; line-height:1.3; margin:0; }
.phm-blog-card__title a { color:#121212; text-decoration:none; transition:color .18s; }
.phm-blog-card__title a:hover { color:#334fb4; }
.phm-blog-card__exc { font-size:13.5px; color:#666; margin:0; line-height:1.6; }
.phm-blog-card__read { font-size:13px; font-weight:700; color:#334fb4; text-decoration:none; margin-top:4px; transition:color .18s; }
.phm-blog-card__read:hover { color:#fea910; }

/* ── FAQ ── */
.phm-faq { background:#f7f5f2; padding:80px 0; }
.phm-faq-list { max-width:760px; margin:0 auto; display:flex; flex-direction:column; gap:12px; }
.phm-faq-item { background:#fff; border:1.5px solid #ede8e0; border-radius:14px; overflow:hidden; transition:border-color .2s; }
.phm-faq-item--open { border-color:#334fb4; }
.phm-faq-q { width:100%; display:flex; justify-content:space-between; align-items:center; gap:12px; padding:18px 22px; background:none; border:none; cursor:pointer; font-size:15px; font-weight:600; font-family:inherit; color:#121212; text-align:left; transition:color .18s; }
.phm-faq-item--open .phm-faq-q { color:#334fb4; }
.phm-faq-icon { font-size:22px; font-weight:300; flex-shrink:0; transition:transform .25s; color:#aaa; }
.phm-faq-item--open .phm-faq-icon { transform:rotate(45deg); color:#334fb4; }
.phm-faq-a { max-height:0; overflow:hidden; transition:max-height .3s ease,padding .3s ease; padding:0 22px; }
.phm-faq-item--open .phm-faq-a { max-height:200px; padding:0 22px 18px; }
.phm-faq-a p { font-size:14.5px; color:#555; margin:0; line-height:1.75; }
.phm-faq-a a { color:#334fb4; }

/* ── CTA STRIP ── */
.phm-cta-strip { background:linear-gradient(135deg,#334fb4 0%,#1e3a8a 100%); padding:44px 0; }
.phm-cta-strip__inner { display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap; }
.phm-cta-strip__text strong { display:block; font-size:19px; font-weight:700; color:#fff; margin-bottom:4px; }
.phm-cta-strip__text span { font-size:14px; color:rgba(255,255,255,.6); }
.phm-cta-strip__actions { display:flex; gap:12px; flex-wrap:wrap; }

/* ── WARM SECTION ── */
.phm-section--warm { background:#fff8f2; }
.phm-eyebrow--rose { color:#be123c; background:#fff1f2; }

/* ── BANDANA SECTION ── */
.phm-section--bandana { background:linear-gradient(135deg,#faf5ff,#f0fdf4); }
.phm-eyebrow--violet { color:#6d28d9; background:#f3e8ff; }
.phm-btn--violet { background:linear-gradient(135deg,#7c3aed,#6d28d9); color:#fff; box-shadow:0 4px 18px rgba(109,40,217,.3); }
.phm-btn--violet:hover { background:linear-gradient(135deg,#6d28d9,#5b21b6); transform:translateY(-2px); box-shadow:0 8px 24px rgba(109,40,217,.4); }
.phm-occ-card--7 { background:linear-gradient(135deg,#faf5ff,#fff); border-color:#ddd6fe; }

/* ── OOS badge ── */
.phm-prod-card__badge--oos { background:#6b7280; color:#fff; }

/* ── SERVICES SECTION ── */
.phm-services { background:linear-gradient(180deg,#f7f5f2 0%,#fff 100%); padding:80px 0; }
.phm-services__grid { display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:stretch; }
.phm-svc-card { border-radius:24px; padding:36px 32px 32px; position:relative; overflow:hidden; display:flex; flex-direction:column; gap:0; }
.phm-svc-card--diet { background:linear-gradient(135deg,#fffbeb 0%,#fff7ed 100%); border:1.5px solid #fde68a; }
.phm-svc-card--vet  { background:linear-gradient(135deg,#eff6ff 0%,#f0fdf4 100%); border:1.5px solid #bfdbfe; }
.phm-svc-card__header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; }
.phm-svc-card__badge { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; padding:5px 12px; border-radius:20px; }
.phm-svc-card--diet .phm-svc-card__badge { background:#fef3c7; color:#92400e; border:1px solid #fde68a; }
.phm-svc-card--vet  .phm-svc-card__badge { background:#dbeafe; color:#1e40af; border:1px solid #bfdbfe; }
.phm-svc-card__icon-wrap { width:56px; height:56px; border-radius:18px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.phm-svc-card--diet .phm-svc-card__icon-wrap { background:rgba(254,169,16,.18); }
.phm-svc-card--vet  .phm-svc-card__icon-wrap { background:rgba(51,79,180,.12); }
.phm-svc-card__icon { font-size:28px; }
.phm-svc-card__body { flex:1; display:flex; flex-direction:column; }
.phm-svc-card__title { font-size:22px; font-weight:800; color:#121212; margin:0 0 10px; line-height:1.2; }
.phm-svc-card__desc { font-size:15px; color:#555; line-height:1.7; margin:0 0 20px; }
.phm-svc-card__list { list-style:none; padding:0; margin:0 0 28px; display:flex; flex-direction:column; gap:9px; }
.phm-svc-card__list li { font-size:14px; font-weight:600; }
.phm-svc-card--diet .phm-svc-card__list li { color:#78350f; }
.phm-svc-card--vet  .phm-svc-card__list li { color:#1e3a5f; }
.phm-svc-card__cta { align-self:flex-start; margin-top:auto; }
.phm-svc-card__decor { position:absolute; bottom:18px; right:20px; font-size:24px; letter-spacing:4px; opacity:.18; pointer-events:none; user-select:none; }

/* ══════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════ */
@media (max-width:1100px) {
  .phm-occasions__grid { grid-template-columns:repeat(4,1fr); }
  .phm-why__grid { grid-template-columns:repeat(2,1fr); }
  .phm-hero__inner { gap:36px; }
