{%- comment -%}
  Petaloons Homepage — Premium UI/UX + SEO for Dog Lehenga · Dog Sherwani · Dog T-Shirt
  CSS scope: .phm-*
{%- endcomment -%}

{%- assign lehenga_col = collections['dog-lehengas'] -%}
{%- assign sherwani_col = collections['dog-sherwani-collection-india'] -%}
{%- assign tshirt_col = collections['dog-t-shirts'] -%}
{%- assign wedding_col = collections['wedding-collection-dog'] -%}
{%- assign ethnic_col = collections['ethnic-wear-for-dogs'] -%}
{%- assign bestsellers_col = collections['avada-best-sellers'] -%}
{%- assign couple_col = collections['dog-couple-dress'] -%}
{%- assign tuxedo_col = collections['dog-tuxedos'] -%}
{%- assign harness_col = collections['harness'] -%}

<!-- ══ STRUCTURED DATA ══ -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "Petaloons",
      "url": "{{ shop.url }}",
      "logo": {%- if settings.logo != blank -%}"{{ settings.logo | image_url: width: 400 }}"{%- else -%}"{{ shop.url }}/cdn/shop/files/petaloons-logo.png"{%- endif -%},
      "description": "India's #1 dog fashion brand. Buy dog lehenga, dog sherwani and dog t-shirts handcrafted in India. Premium pet clothing for weddings, festivals and everyday wear.",
      "contactPoint": { "@type": "ContactPoint", "contactType": "customer service", "availableLanguage": "English" },
      "sameAs": [
        {%- if settings.social_instagram_link != blank -%}"{{ settings.social_instagram_link }}",{%- endif -%}
        {%- if settings.social_facebook_link != blank -%}"{{ settings.social_facebook_link }}"{%- endif -%}
      ]
    },
    {
      "@type": "WebSite",
      "name": "Petaloons — Dog Lehenga, Dog Sherwani & Dog T-Shirts",
      "url": "{{ shop.url }}",
      "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "{{ shop.url }}/search?q={query}" }, "query-input": "required name=query" }
    },
    {
      "@type": "ItemList",
      "name": "Dog Lehenga Collection — Petaloons",
      "description": "Shop India's best dog lehenga for weddings, Diwali and all festive occasions. Handcrafted bridal lehenga choli for female dogs.",
      "url": "{{ shop.url }}/collections/dog-lehengas",
      "numberOfItems": {{ lehenga_col.products_count }},
      "itemListElement": [
        {%- for product in lehenga_col.products limit: 6 -%}
        { "@type": "ListItem", "position": {{ forloop.index }}, "name": "{{ product.title | escape }}", "url": "{{ shop.url }}{{ product.url }}", "item": { "@type": "Product", "name": "{{ product.title | escape }}", "offers": { "@type": "Offer", "price": "{{ product.price | money_without_currency }}", "priceCurrency": "INR", "availability": "{%- if product.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}" } } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    },
    {
      "@type": "ItemList",
      "name": "Dog Sherwani Collection — Petaloons",
      "description": "Buy premium dog sherwani for weddings and festivals. Indian ethnic wear for male dogs — sherwanis, kurtas and more.",
      "url": "{{ shop.url }}/collections/dog-sherwani-collection-india",
      "numberOfItems": {{ sherwani_col.products_count }},
      "itemListElement": [
        {%- for product in sherwani_col.products limit: 6 -%}
        { "@type": "ListItem", "position": {{ forloop.index }}, "name": "{{ product.title | escape }}", "url": "{{ shop.url }}{{ product.url }}", "item": { "@type": "Product", "name": "{{ product.title | escape }}", "offers": { "@type": "Offer", "price": "{{ product.price | money_without_currency }}", "priceCurrency": "INR", "availability": "{%- if product.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}" } } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Where can I buy a dog lehenga in India?", "acceptedAnswer": { "@type": "Answer", "text": "Petaloons is India's #1 dog lehenga brand. Shop 24+ handcrafted dog lehengas for weddings, Diwali and festivals online at petaloons.com with pan-India delivery." } },
        { "@type": "Question", "name": "Where to buy dog sherwani for wedding in India?", "acceptedAnswer": { "@type": "Answer", "text": "Petaloons offers 30+ premium dog sherwanis for weddings and festivals. Each sherwani is handcrafted in India with premium fabric. Shop online at petaloons.com/collections/dog-sherwani-collection-india." } },
        { "@type": "Question", "name": "What size dog t-shirt should I buy?", "acceptedAnswer": { "@type": "Answer", "text": "Measure your dog's chest girth, neck and back length. Petaloons dog t-shirts are available in XS–XXL to fit all breeds from Chihuahua to Golden Retriever. Check our size guide for exact measurements." } },
        { "@type": "Question", "name": "Are Petaloons dog clothes safe and comfortable?", "acceptedAnswer": { "@type": "Answer", "text": "Yes! All Petaloons dog clothes are made from pet-safe, skin-friendly fabrics. They are tested by real dog parents and designed for comfort, mobility and style." } },
        { "@type": "Question", "name": "Does Petaloons deliver across India?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, Petaloons delivers pan-India including Mumbai, Delhi, Bangalore, Chennai, Hyderabad, Pune, Kolkata and all major cities. Free shipping on orders above ₹999." } }
      ]
    }
  ]
}
</script>

