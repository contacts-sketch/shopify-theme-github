{%- comment -%}
  Petaloons Homepage — Premium UI/UX + SEO for Dog Lehenga · Dog Sherwani · Dog T-Shirt
  CSS scope: .phm-*
{%- endcomment -%}

{%- assign lehenga_col = collections['dog-lehengas'] -%}
{%- assign sherwani_col = collections['dog-sherwani-collection-india'] -%}
{%- assign tshirt_col = collections['dog-t-shirts'] -%}
{%- assign wedding_col = collections['wedding-collection-dog'] -%}
{%- assign ethnic_col = collections['ethnic-wear-for-dogs'] -%}
{%- assign bestsellers_col = collections['avada-best-sellers'] -%}
{%- assign couple_col = collections['dog-couple-dress'] -%}
{%- assign tuxedo_col = collections['dog-tuxedos'] -%}
{%- assign harness_col = collections['harness'] -%}
{%- assign bandana_col = collections['dog-bandanas'] -%}

{%- comment -%} Build sameAs array safely (no trailing comma) {%- endcomment -%}
{%- assign phm_same_as = '' -%}
{%- if settings.social_instagram_link != blank -%}
  {%- assign phm_same_as = phm_same_as | append: '"' | append: settings.social_instagram_link | append: '"' -%}
{%- endif -%}
{%- if settings.social_facebook_link != blank -%}
  {%- if phm_same_as != '' -%}{%- assign phm_same_as = phm_same_as | append: ',' -%}{%- endif -%}
  {%- assign phm_same_as = phm_same_as | append: '"' | append: settings.social_facebook_link | append: '"' -%}
{%- endif -%}
{%- if settings.social_youtube_link != blank -%}
  {%- if phm_same_as != '' -%}{%- assign phm_same_as = phm_same_as | append: ',' -%}{%- endif -%}
  {%- assign phm_same_as = phm_same_as | append: '"' | append: settings.social_youtube_link | append: '"' -%}
{%- endif -%}

<!-- ══ STRUCTURED DATA ══ -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ shop.url }}/#organization",
      "name": "Petaloons",
      "url": "{{ shop.url }}",
      "logo": {
        "@type": "ImageObject",
        "url": {%- if settings.logo != blank -%}"{{ settings.logo | image_url: width: 400 }}"{%- else -%}"{{ shop.url }}/cdn/shop/files/petaloons-logo.png"{%- endif -%},
        "width": 400,
        "height": 100
      },
      "description": "India's #1 dog fashion brand. Buy dog lehenga, dog sherwani and dog t-shirts handcrafted in India. Premium pet clothing for weddings, festivals and everyday wear.",
      "foundingDate": "2020",
      "areaServed": { "@type": "Country", "name": "India" },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "2000",
        "bestRating": "5",
        "worstRating": "1"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "availableLanguage": ["English", "Hindi"],
        "areaServed": "IN"
      },
      "sameAs": [{{ phm_same_as }}]
    },
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "name": "Petaloons — Dog Lehenga, Dog Sherwani & Dog T-Shirts",
      "url": "{{ shop.url }}",
      "description": "India's #1 dog fashion brand. Shop handcrafted dog lehenga, dog sherwani and dog t-shirts online with pan-India delivery.",
      "inLanguage": "en-IN",
      "publisher": { "@id": "{{ shop.url }}/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "{{ shop.url }}/search?q={query}" },
        "query-input": "required name=query"
      }
    },
    {
      "@type": "WebPage",
      "@id": "{{ shop.url }}/#webpage",
      "url": "{{ shop.url }}",
      "name": "Dog Lehenga, Dog Sherwani & Dog T-Shirt | Petaloons — India's #1 Pet Fashion",
      "description": "Shop India's best dog lehenga, dog sherwani & dog t-shirts at Petaloons. Handcrafted for all breeds, pan-India delivery. Free shipping ₹999+. 10,000+ happy pet parents.",
      "isPartOf": { "@id": "{{ shop.url }}/#website" },
      "about": { "@id": "{{ shop.url }}/#organization" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ shop.url }}" }]
      }
    },
    {
      "@type": "ItemList",
      "name": "Dog Lehenga Collection — Petaloons",
      "description": "Shop India's best dog lehenga for weddings, Diwali and all festive occasions. Handcrafted bridal lehenga choli for female dogs.",
      "url": "{{ shop.url }}/collections/dog-lehengas",
      "numberOfItems": {{ lehenga_col.products_count }},
      "itemListElement": [
        {%- for product in lehenga_col.products limit: 6 -%}
        { "@type": "ListItem", "position": {{ forloop.index }}, "name": "{{ product.title | escape }}", "url": "{{ shop.url }}{{ product.url }}", "item": { "@type": "Product", "name": "{{ product.title | escape }}", "brand": { "@type": "Brand", "name": "Petaloons" }, "offers": { "@type": "Offer", "price": "{{ product.price | divided_by: 100.0 }}", "priceCurrency": "INR", "availability": "{%- if product.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}", "seller": { "@type": "Organization", "name": "Petaloons" } } } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    },
    {
      "@type": "ItemList",
      "name": "Dog Sherwani Collection — Petaloons",
      "description": "Buy premium dog sherwani for weddings and festivals. Indian ethnic wear for male dogs — sherwanis, kurtas and more.",
      "url": "{{ shop.url }}/collections/dog-sherwani-collection-india",
      "numberOfItems": {{ sherwani_col.products_count }},
      "itemListElement": [
        {%- for product in sherwani_col.products limit: 6 -%}
        { "@type": "ListItem", "position": {{ forloop.index }}, "name": "{{ product.title | escape }}", "url": "{{ shop.url }}{{ product.url }}", "item": { "@type": "Product", "name": "{{ product.title | escape }}", "brand": { "@type": "Brand", "name": "Petaloons" }, "offers": { "@type": "Offer", "price": "{{ product.price | divided_by: 100.0 }}", "priceCurrency": "INR", "availability": "{%- if product.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}", "seller": { "@type": "Organization", "name": "Petaloons" } } } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    },
    {
      "@type": "ItemList",
      "name": "Dog T-Shirt Collection — Petaloons",
      "description": "Shop comfortable dog t-shirts for all breeds. Casual, printed and sporty dog t-shirts available in XS–XXL. Pan-India delivery.",
      "url": "{{ shop.url }}/collections/dog-t-shirts",
      "numberOfItems": {{ tshirt_col.products_count }},
      "itemListElement": [
        {%- for product in tshirt_col.products limit: 6 -%}
        { "@type": "ListItem", "position": {{ forloop.index }}, "name": "{{ product.title | escape }}", "url": "{{ shop.url }}{{ product.url }}", "item": { "@type": "Product", "name": "{{ product.title | escape }}", "brand": { "@type": "Brand", "name": "Petaloons" }, "offers": { "@type": "Offer", "price": "{{ product.price | divided_by: 100.0 }}", "priceCurrency": "INR", "availability": "{%- if product.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}", "seller": { "@type": "Organization", "name": "Petaloons" } } } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Where can I buy a dog lehenga in India?", "acceptedAnswer": { "@type": "Answer", "text": "Petaloons is India's #1 dog lehenga brand. Shop 24+ handcrafted dog lehengas for weddings, Diwali and festivals online at petaloons.com with pan-India delivery. We ship to Mumbai, Delhi, Bangalore, Pune and all major Indian cities." } },
        { "@type": "Question", "name": "Where to buy dog sherwani for wedding in India?", "acceptedAnswer": { "@type": "Answer", "text": "Petaloons offers 30+ premium dog sherwanis for weddings and festivals. Each dog sherwani is handcrafted in India with premium brocade fabric. Shop online at petaloons.com/collections/dog-sherwani-collection-india with free shipping above ₹999." } },
        { "@type": "Question", "name": "What size dog t-shirt should I buy for my dog?", "acceptedAnswer": { "@type": "Answer", "text": "Measure your dog's chest girth, neck circumference and back length. Petaloons dog t-shirts are available in XS–XXL to fit all breeds from Chihuahua to Golden Retriever. Each product page includes a size chart for reference." } },
        { "@type": "Question", "name": "Are Petaloons dog clothes safe and comfortable?", "acceptedAnswer": { "@type": "Answer", "text": "Yes! All Petaloons dog clothes are made from pet-safe, skin-friendly fabrics with non-toxic dyes. They are tested by real dog parents for comfort and mobility before every launch." } },
        { "@type": "Question", "name": "Does Petaloons deliver across India?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, Petaloons delivers pan-India including Mumbai, Delhi, Bangalore, Chennai, Hyderabad, Pune, Kolkata, Jaipur and all major cities. Free shipping on all orders above ₹999. Express delivery available in metro cities." } },
        { "@type": "Question", "name": "Can I return a dog outfit if it doesn't fit?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, Petaloons has an easy 7-day return policy. If a dog lehenga, dog sherwani or dog t-shirt doesn't fit, contact our team within 7 days of delivery. We recommend using our detailed size guide before ordering." } }
      ]
    }
  ]
}
</script>

<div class="phm-page" id="petaloons-home">

  <!-- ══ HERO ══ -->
  <section class="phm-hero" aria-label="Petaloons — India's #1 Dog Fashion Brand">
    <div class="phm-hero__glow phm-hero__glow--tl" aria-hidden="true"></div>
    <div class="phm-hero__glow phm-hero__glow--br" aria-hidden="true"></div>
    <div class="phm-hero__pattern" aria-hidden="true">
      <svg width="100%" height="100%" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid slice"><defs><pattern id="paw-grid" width="60" height="60" patternUnits="userSpaceOnUse"><circle cx="30" cy="30" r="1.5" fill="rgba(255,255,255,0.08)"/><circle cx="30" cy="30" r="8" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/></pattern></defs><rect width="100%" height="100%" fill="url(#paw-grid)"/></svg>
    </div>

    <div class="phm-hero__inner">
      <!-- LEFT: Text content -->
      <div class="phm-hero__content">
        <div class="phm-hero__badges">
          <span class="phm-badge phm-badge--frosted">🇮🇳 Made in India</span>
          <span class="phm-badge phm-badge--frosted"><span class="phm-badge__dot"></span>10,000+ Happy Pet Parents</span>
          <span class="phm-badge phm-badge--gold">⭐ 4.8 Rated</span>
        </div>

        <h1 class="phm-hero__title">
          India's #1 Dog Fashion<br>
          <span class="phm-hero__title-shine">Dog Lehenga · Sherwani · T-Shirt</span>
        </h1>

        <p class="phm-hero__sub">Shop India's finest handcrafted <strong>dog lehengas</strong>, <strong>dog sherwanis</strong> &amp; <strong>dog t-shirts</strong>. Premium quality, every breed, pan-India delivery. 🐾</p>

        <div class="phm-hero__kw-row">
          <a href="/collections/dog-lehengas" class="phm-hero__kw-pill">👗 Dog Lehenga</a>
          <a href="/collections/dog-sherwani-collection-india" class="phm-hero__kw-pill">🤵 Dog Sherwani</a>
          <a href="/collections/dog-t-shirts" class="phm-hero__kw-pill">👕 Dog T-Shirts</a>
        </div>

        <div class="phm-hero__ctas">
          <a href="/collections/dog-lehengas" class="phm-btn phm-btn--hero-primary">
            Shop Now →
          </a>
          <a href="/collections/all" class="phm-btn phm-btn--hero-secondary">View All Outfits</a>
        </div>

        <div class="phm-hero__trust">
          <div class="phm-trust-item"><span>✓</span> Free Shipping ₹999+</div>
          <div class="phm-trust-item"><span>✓</span> Easy Returns</div>
          <div class="phm-trust-item"><span>✓</span> Secure Payments</div>
          <div class="phm-trust-item"><span>✓</span> Pan-India Delivery</div>
        </div>
      </div>

      <!-- RIGHT: Product image showcase -->
      <div class="phm-hero__showcase" aria-label="Featured dog fashion outfits">
        <div class="phm-hero__showcase-main">
          <a href="/collections/dog-lehengas" class="phm-hpc phm-hpc--lehenga" aria-label="Shop Dog Lehenga">
            <div class="phm-hpc__img-wrap">
              <img src="https://cdn.shopify.com/s/files/1/0611/1107/4890/files/1.0.png?v=1777115848&width=480"
                   srcset="https://cdn.shopify.com/s/files/1/0611/1107/4890/files/1.0.png?v=1777115848&width=240 240w,
                           https://cdn.shopify.com/s/files/1/0611/1107/4890/files/1.0.png?v=1777115848&width=360 360w,
                           https://cdn.shopify.com/s/files/1/0611/1107/4890/files/1.0.png?v=1777115848&width=480 480w,
                           https://cdn.shopify.com/s/files/1/0611/1107/4890/files/1.0.png?v=1777115848&width=720 720w"
                   sizes="(min-width: 990px) 260px, (min-width: 750px) 40vw, 55vw"
                   alt="Dog wearing festive pink lehenga — Dog Lehenga by Petaloons"
                   loading="eager" fetchpriority="high" width="480" height="600">
            </div>
            <div class="phm-hpc__label">
              <span class="phm-hpc__cat">👗 Dog Lehenga</span>
              <span class="phm-hpc__cta">Shop →</span>
            </div>
          </a>
        </div>

        <div class="phm-hero__showcase-side">
          <a href="/collections/dog-sherwani-collection-india" class="phm-hpc phm-hpc--sherwani" aria-label="Shop Dog Sherwani">
            <div class="phm-hpc__img-wrap">
              <img src="https://cdn.shopify.com/s/files/1/0611/1107/4890/files/2_46f7ba19-e4ea-4982-aafb-6d74e5c22a09.png?v=1774954499&width=320"
                   srcset="https://cdn.shopify.com/s/files/1/0611/1107/4890/files/2_46f7ba19-e4ea-4982-aafb-6d74e5c22a09.png?v=1774954499&width=200 200w,
                           https://cdn.shopify.com/s/files/1/0611/1107/4890/files/2_46f7ba19-e4ea-4982-aafb-6d74e5c22a09.png?v=1774954499&width=320 320w,
                           https://cdn.shopify.com/s/files/1/0611/1107/4890/files/2_46f7ba19-e4ea-4982-aafb-6d74e5c22a09.png?v=1774954499&width=480 480w"
                   sizes="(min-width: 990px) 200px, 35vw"
                   alt="Dog wearing maroon velvet sherwani for wedding by Petaloons"
                   loading="eager" fetchpriority="auto" width="320" height="380">
            </div>
            <div class="phm-hpc__label">
              <span class="phm-hpc__cat">🤵 Dog Sherwani</span>
              <span class="phm-hpc__cta">Shop →</span>
            </div>
          </a>

          <a href="/collections/dog-t-shirts" class="phm-hpc phm-hpc--tshirt" aria-label="Shop Dog T-Shirts">
            <div class="phm-hpc__img-wrap">
              <img src="https://cdn.shopify.com/s/files/1/0611/1107/4890/files/baseball-style-t-shirt-for-dogs-_2.jpg?v=1749023686&width=320"
                   srcset="https://cdn.shopify.com/s/files/1/0611/1107/4890/files/baseball-style-t-shirt-for-dogs-_2.jpg?v=1749023686&width=200 200w,
                           https://cdn.shopify.com/s/files/1/0611/1107/4890/files/baseball-style-t-shirt-for-dogs-_2.jpg?v=1749023686&width=320 320w"
                   sizes="(min-width: 990px) 200px, 35vw"
                   alt="Dog wearing sports jersey t-shirt by Petaloons"
                   loading="lazy" width="320" height="280">
            </div>
            <div class="phm-hpc__label">
              <span class="phm-hpc__cat">👕 Dog T-Shirt</span>
              <span class="phm-hpc__cta">Shop →</span>
            </div>
          </a>
        </div>

        <!-- Floating rating pill -->
        <div class="phm-hero__fpill phm-hero__fpill--rating" aria-label="Customer rating">
          <span class="phm-hero__fstars">★★★★★</span>
          <span>4.8 · 2,000+ Reviews</span>
        </div>

        <!-- Floating new badge -->
        <div class="phm-hero__fnew" aria-hidden="true">
          ✨ New<br>Collection<br>2026
        </div>
      </div>
    </div>
  </section>

  <!-- ══ STATS BAR ══ -->
  <div class="phm-stats-bar">
    <div class="phm-stats-bar__inner">
      <div class="phm-stat"><strong>10,000+</strong><span>Happy Pet Parents</span></div>
      <div class="phm-stat__div"></div>
      <div class="phm-stat"><strong>200+</strong><span>Outfit Designs</span></div>
      <div class="phm-stat__div"></div>
      <div class="phm-stat"><strong>4.8 ★</strong><span>Average Rating</span></div>
      <div class="phm-stat__div"></div>
      <div class="phm-stat"><strong>100%</strong><span>Made in India</span></div>
      <div class="phm-stat__div"></div>
      <div class="phm-stat"><strong>Free</strong><span>Shipping ₹999+</span></div>
    </div>
  </div>

  <!-- ══ SHOP BY OCCASION ══ -->
  <section class="phm-occasions">
    <div class="phm-section-inner">
      <div class="phm-section-hd">
        <span class="phm-eyebrow">Every Celebration</span>
        <h2 class="phm-section-title">Shop by Occasion</h2>
      </div>
      <div class="phm-occasions__grid">
        <a href="/collections/wedding-collection-dog" class="phm-occ-card phm-occ-card--1">
          <div class="phm-occ-card__icon">💍</div>
          <strong>Weddings</strong>
          <span>{{ wedding_col.products_count }}+ styles</span>
        </a>
        <a href="/collections/ethnic-wear-for-dogs" class="phm-occ-card phm-occ-card--2">
          <div class="phm-occ-card__icon">🪔</div>
          <strong>Festivals &amp; Ethnic</strong>
          <span>{{ ethnic_col.products_count }}+ styles</span>
        </a>
        <a href="/collections/dog-lehengas" class="phm-occ-card phm-occ-card--3">
          <div class="phm-occ-card__icon">👗</div>
          <strong>Dog Lehenga</strong>
          <span>{{ lehenga_col.products_count }}+ styles</span>
        </a>
        <a href="/collections/dog-sherwani-collection-india" class="phm-occ-card phm-occ-card--4">
          <div class="phm-occ-card__icon">🤵</div>
          <strong>Dog Sherwani</strong>
          <span>{{ sherwani_col.products_count }}+ styles</span>
        </a>
        <a href="/collections/dog-t-shirts" class="phm-occ-card phm-occ-card--5">
          <div class="phm-occ-card__icon">👕</div>
          <strong>Dog T-Shirts</strong>
          <span>{{ tshirt_col.products_count }}+ styles</span>
        </a>
        <a href="/collections/🎉-dog-birthday-pawty-collection-🐾" class="phm-occ-card phm-occ-card--6">
          <div class="phm-occ-card__icon">🎂</div>
          <strong>Birthday</strong>
          <span>19+ styles</span>
        </a>
        <a href="/collections/dog-bandanas" class="phm-occ-card phm-occ-card--7">
          <div class="phm-occ-card__icon">🧣</div>
          <strong>Dog Bandanas</strong>
          <span>{{ bandana_col.products_count }}+ styles</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══ DOG LEHENGA ══ -->
  <section class="phm-collection-section phm-section--light" id="dog-lehenga">
    <div class="phm-section-inner">
      <div class="phm-collection-hd">
        <div>
          <span class="phm-eyebrow">Most Loved</span>
          <h2 class="phm-section-title">Dog Lehenga for Weddings &amp; Festivals</h2>
          <p class="phm-section-sub">India's finest handcrafted dog lehengas — bridal, festive and ethnic. Made for female dogs who deserve to shine at every celebration.</p>
        </div>
        <a href="/collections/dog-lehengas" class="phm-btn phm-btn--outline phm-view-all">View All {{ lehenga_col.products_count }} Lehengas →</a>
      </div>
      <div class="phm-prod-grid">
        {%- for product in lehenga_col.products limit: 4 -%}
          {%- assign badge = '' -%}
          {%- if forloop.index == 1 -%}{%- assign badge = 'Bestseller' -%}{%- endif -%}
          {%- if product.compare_at_price > product.price -%}{%- assign badge = 'Sale' -%}{%- endif -%}
          {%- render 'phm-product-card', product: product, badge: badge -%}
        {%- else -%}
          <p class="phm-empty">No products found.</p>
        {%- endfor -%}
      </div>
      <div class="phm-collection-cta">
        <a href="/collections/dog-lehengas" class="phm-btn phm-btn--amber">Browse All Dog Lehengas →</a>
      </div>
    </div>
  </section>

  <!-- ══ DOG SHERWANI ══ -->
  <section class="phm-collection-section phm-section--dark" id="dog-sherwani">
    <div class="phm-section-inner">
      <div class="phm-collection-hd phm-collection-hd--dark">
        <div>
          <span class="phm-eyebrow phm-eyebrow--amber">Top Sellers</span>
          <h2 class="phm-section-title phm-title--white">Dog Sherwani for Weddings &amp; Celebrations</h2>
          <p class="phm-section-sub phm-sub--muted">Dress your male dog like a raja. Premium sherwanis, kurtas and achkans for weddings, Diwali and every grand Indian occasion.</p>
        </div>
        <a href="/collections/dog-sherwani-collection-india" class="phm-btn phm-btn--white phm-view-all">View All {{ sherwani_col.products_count }} Sherwanis →</a>
      </div>
      <div class="phm-prod-grid">
        {%- for product in sherwani_col.products limit: 4 -%}
          {%- assign badge = '' -%}
          {%- if forloop.index == 1 -%}{%- assign badge = 'Bestseller' -%}{%- endif -%}
          {%- if product.compare_at_price > product.price -%}{%- assign badge = 'Sale' -%}{%- endif -%}
          {%- render 'phm-product-card', product: product, badge: badge, dark: true -%}
        {%- else -%}
          <p class="phm-empty">No products found.</p>
        {%- endfor -%}
      </div>
      <div class="phm-collection-cta">
        <a href="/collections/dog-sherwani-collection-india" class="phm-btn phm-btn--amber">Browse All Dog Sherwanis →</a>
      </div>
    </div>
  </section>

  <!-- ══ DOG T-SHIRTS ══ -->
  <section class="phm-collection-section phm-section--light" id="dog-tshirts">
    <div class="phm-section-inner">
      <div class="phm-collection-hd">
        <div>
