<style>
  .p404 {
    max-width: 860px;
    margin: 0 auto;
    padding: 48px 20px 80px;
    font-family: Georgia, serif;
    color: #2c2c2c;
  }
  .p404__hero {
    text-align: center;
    padding-bottom: 40px;
    border-bottom: 2px solid #e8ddd0;
    margin-bottom: 40px;
  }
  .p404__paw { font-size: 48px; margin-bottom: 12px; }
  .p404__title {
    font-size: 36px;
    color: #7b2d2d;
    margin-bottom: 10px;
    line-height: 1.2;
  }
  .p404__sub {
    font-size: 16px;
    color: #666;
    margin-bottom: 28px;
    line-height: 1.6;
  }
  .p404__search {
    display: flex;
    max-width: 480px;
    margin: 0 auto;
    gap: 0;
    border: 2px solid #7b2d2d;
    border-radius: 8px;
    overflow: hidden;
  }
  .p404__search input {
    flex: 1;
    padding: 12px 16px;
    font-size: 15px;
    border: none;
    outline: none;
    background: #fff;
    color: #2c2c2c;
    font-family: inherit;
  }
  .p404__search button {
    background: #7b2d2d;
    color: #fff;
    border: none;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
  }
  .p404__search button:hover { background: #5e2020; }

  .p404__section-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #b8852a;
    margin-bottom: 16px;
  }
  .p404__products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }
  .p404__product-card {
    text-decoration: none;
    color: inherit;
    border: 1px solid #e8ddd0;
    border-radius: 10px;
    overflow: hidden;
    transition: box-shadow .2s;
  }
  .p404__product-card:hover { box-shadow: 0 4px 16px rgba(123,45,45,.12); }
  .p404__product-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }
  .p404__product-info {
    padding: 10px 12px;
  }
  .p404__product-name {
    font-size: 13px;
    font-weight: 600;
    color: #2c2c2c;
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .p404__product-price {
    font-size: 12px;
    color: #7b2d2d;
    font-weight: 700;
  }

  .p404__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 40px;
  }
  .p404__link {
    display: inline-block;
    padding: 9px 18px;
    border: 1.5px solid #7b2d2d;
    border-radius: 6px;
    color: #7b2d2d;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: background .15s, color .15s;
  }
  .p404__link:hover { background: #7b2d2d; color: #fff; }

  .p404__back {
    text-align: center;
    margin-top: 24px;
  }
  .p404__back a {
    color: #666;
    font-size: 13px;
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .p404__title { font-size: 26px; }
    .p404__products { grid-template-columns: repeat(2, 1fr); }
  }
</style>

{%- assign featured = collections['dog-ethnic-wear'] -%}
{%- if featured == blank -%}
  {%- assign featured = collections.all -%}
{%- endif -%}

<div class="p404">

  <div class="p404__hero">
    <div class="p404__paw">🐾</div>
    <h1 class="p404__title">This page ran away like a dog off-leash.</h1>
    <p class="p404__sub">We couldn't find what you're looking for — but we have plenty of outfits<br>your dog will love. Try searching below.</p>
    <form action="{{ routes.search_url }}" method="get" class="p404__search">
      <input type="text" name="q" placeholder="Search dog lehenga, sherwani, kurta…" aria-label="Search">
      <button type="submit">Search →</button>
    </form>
  </div>

  {%- if featured.products.size > 0 -%}
  <div class="p404__section-label">Bestsellers</div>
  <div class="p404__products">
    {%- for product in featured.products limit: 4 -%}
    <a href="{{ product.url }}" class="p404__product-card">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 400 }}"
             alt="{{ product.featured_image.alt | default: product.title | escape }}"
             loading="lazy" width="400" height="400">
      {%- endif -%}
      <div class="p404__product-info">
        <div class="p404__product-name">{{ product.title }}</div>
        <div class="p404__product-price">{{ product.price | money }}</div>
      </div>
    </a>
    {%- endfor -%}
  </div>
  {%- endif -%}

  <div class="p404__section-label">Browse by category</div>
  <div class="p404__links">
    <a href="/collections/dog-lehenga" class="p404__link">Dog Lehenga</a>
    <a href="/collections/dog-sherwani" class="p404__link">Dog Sherwani</a>
    <a href="/collections/dog-kurta" class="p404__link">Dog Kurta</a>
    <a href="/collections/dog-bandana" class="p404__link">Dog Bandana</a>
    <a href="/collections/dog-tshirt" class="p404__link">Dog T-Shirts</a>
    <a href="/blogs/pet-blog" class="p404__link">Pet Blog</a>
    <a href="/pages/contact" class="p404__link">Contact Us</a>
  </div>

  <div class="p404__back">
    <a href="{{ routes.root_url }}">← Back to Petaloons homepage</a>
  </div>

</div>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section"
}
{% endschema %}
