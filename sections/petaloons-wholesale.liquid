<script>
  // FAQ accordion
  document.querySelectorAll('.pws-faq__q').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var ans = btn.nextElementSibling;
      var isOpen = btn.classList.contains('open');
      btn.closest('.pws-faq__inner').querySelectorAll('.pws-faq__q').forEach(function(b){ b.classList.remove('open'); b.setAttribute('aria-expanded','false'); });
      btn.closest('.pws-faq__inner').querySelectorAll('.pws-faq__a').forEach(function(a){ a.classList.remove('open'); });
      if (!isOpen) { btn.classList.add('open'); btn.setAttribute('aria-expanded','true'); ans.classList.add('open'); }
    });
  });
</script>

