{% comment %}
  Petaloons Wholesale / B2B Partner Page
  CSS scope: .pws-*
  URL: /pages/wholesale
{% endcomment %}

<style>
  .pws-wrap * { box-sizing: border-box; }
  .pws-wrap { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1a1a1a; }

  /* ─── Hero ─────────────────────────────────────── */
  .pws-hero {
    position: relative;
    background: linear-gradient(135deg, #0f1117 0%, #1e3a8a 45%, #b84500 100%);
    padding: 80px 24px 100px;
    text-align: center;
    overflow: hidden;
  }
  .pws-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Ccircle cx='40' cy='40' r='5'/%3E%3C/g%3E%3C/svg%3E");
  }
  .pws-hero__breadcrumb {
    position: relative;
    font-size: 13px;
    color: rgba(255,255,255,.65);
    margin-bottom: 24px;
  }
  .pws-hero__breadcrumb a { color: rgba(255,255,255,.8); text-decoration: none; }
  .pws-hero__breadcrumb a:hover { color: #fff; text-decoration: underline; }
  .pws-hero__badge {
    position: relative;
    display: inline-block;
    background: rgba(254,169,16,.2);
    border: 1px solid rgba(254,169,16,.5);
    color: #fea910;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 20px;
    border-radius: 30px;
    margin-bottom: 20px;
  }
  .pws-hero__title {
    position: relative;
    font-size: clamp(2rem, 5.5vw, 3.6rem);
    font-weight: 900;
    color: #fff;
    margin: 0 0 16px;
    line-height: 1.1;
    letter-spacing: -1.5px;
  }
  .pws-hero__title span { color: #fea910; }
  .pws-hero__sub {
    position: relative;
    font-size: 1.1rem;
    color: rgba(255,255,255,.8);
    max-width: 580px;
    margin: 0 auto 36px;
    line-height: 1.65;
  }
  .pws-hero__cta-group {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }
  .pws-hero__cta {
    padding: 15px 32px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .pws-hero__cta--primary { background: #fea910; color: #0f1117; }
  .pws-hero__cta--primary:hover { background: #ffbe3d; transform: translateY(-2px); text-decoration: none; }
  .pws-hero__cta--outline { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.4); }
  .pws-hero__cta--outline:hover { background: rgba(255,255,255,.1); border-color: #fff; text-decoration: none; }
  .pws-hero__stats {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
    border-top: 1px solid rgba(255,255,255,.1);
    padding-top: 36px;
  }
  .pws-hero__stat {
    padding: 0 40px;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,.12);
  }
  .pws-hero__stat:last-child { border-right: none; }
  .pws-hero__stat-val {
    font-size: 2rem;
    font-weight: 900;
    color: #fea910;
    display: block;
    line-height: 1;
    margin-bottom: 6px;
  }
  .pws-hero__stat-label { font-size: 12.5px; color: rgba(255,255,255,.6); font-weight: 500; }
  .pws-hero__wave {
    position: absolute;
    bottom: -2px; left: 0; width: 100%; line-height: 0;
  }

  /* ─── Benefits ──────────────────────────────────── */
  .pws-benefits {
    background: #fdf9f6;
    padding: 80px 24px;
  }
  .pws-benefits__inner { max-width: 1100px; margin: 0 auto; }
  .pws-section-head { text-align: center; margin-bottom: 52px; }
  .pws-section-head__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #b84500;
    margin-bottom: 12px;
  }
  .pws-section-head__title {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 900;
    color: #1a1a1a;
    margin: 0 0 12px;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }
  .pws-section-head__sub {
    font-size: 15px;
    color: #666;
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .pws-benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .pws-benefit-card {
    background: #fff;
    border-radius: 20px;
    padding: 32px 28px;
    border: 1.5px solid #f0e8e0;
    box-shadow: 0 4px 20px rgba(0,0,0,.06);
    transition: transform .22s, box-shadow .22s, border-color .22s;
    position: relative;
    overflow: hidden;
  }
  .pws-benefit-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, #b84500, #fea910);
    opacity: 0;
    transition: opacity .2s;
  }
  .pws-benefit-card:hover { transform: translateY(-5px); box-shadow: 0 14px 40px rgba(184,69,0,.14); border-color: #b84500; }
  .pws-benefit-card:hover::before { opacity: 1; }
  .pws-benefit-icon {
    width: 56px; height: 56px;
    background: linear-gradient(135deg, #fff3eb, #ffe0cc);
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-size: 26px;
    margin-bottom: 20px;
  }
  .pws-benefit-card h3 { font-size: 1.05rem; font-weight: 800; color: #1a1a1a; margin: 0 0 10px; }
  .pws-benefit-card p { font-size: 14px; color: #555; line-height: 1.65; margin: 0; }

  /* ─── How It Works ──────────────────────────────── */
  .pws-how {
    background: #fff;
    padding: 80px 24px;
    border-top: 1px solid #f0e8e0;
  }
  .pws-how__inner { max-width: 900px; margin: 0 auto; }
  .pws-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    position: relative;
    margin-top: 52px;
  }
  .pws-steps::before {
    content: '';
    position: absolute;
    top: 36px;
    left: calc(16.66% + 18px);
    width: calc(66.66% - 36px);
    height: 2px;
    background: linear-gradient(90deg, #b84500, #fea910);
    z-index: 0;
  }
  .pws-step {
    text-align: center;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }
  .pws-step__num {
    width: 72px; height: 72px;
    background: linear-gradient(135deg, #b84500, #de7200);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 28px;
    margin: 0 auto 20px;
    box-shadow: 0 6px 20px rgba(184,69,0,.3);
  }
  .pws-step h3 { font-size: 1rem; font-weight: 800; color: #1a1a1a; margin: 0 0 8px; }
  .pws-step p { font-size: 13.5px; color: #666; line-height: 1.6; margin: 0; }

  /* ─── Pricing Tiers ─────────────────────────────── */
  .pws-tiers {
    background: #0f1117;
    padding: 80px 24px;
  }
  .pws-tiers__inner { max-width: 1100px; margin: 0 auto; }
  .pws-tiers .pws-section-head__title { color: #fff; }
  .pws-tiers .pws-section-head__sub   { color: rgba(255,255,255,.6); }
  .pws-tiers .pws-section-head__eyebrow { color: #fea910; }
  .pws-tiers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 52px;
  }
  .pws-tier-card {
    background: rgba(255,255,255,.05);
    border: 1.5px solid rgba(255,255,255,.1);
    border-radius: 20px;
    padding: 36px 28px;
    text-align: center;
    position: relative;
    transition: transform .2s, border-color .2s;
  }
  .pws-tier-card:hover { transform: translateY(-5px); border-color: rgba(254,169,16,.5); }
  .pws-tier-card--featured {
    background: linear-gradient(135deg, rgba(184,69,0,.25), rgba(222,114,0,.15));
    border-color: #b84500;
    transform: scale(1.04);
  }
  .pws-tier-card--featured:hover { transform: scale(1.04) translateY(-4px); }
  .pws-tier-badge {
    position: absolute;
    top: -14px; left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(90deg, #b84500, #fea910);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 5px 18px;
    border-radius: 20px;
    white-space: nowrap;
  }
  .pws-tier-icon { font-size: 40px; margin-bottom: 14px; display: block; }
  .pws-tier-name { font-size: 1.1rem; font-weight: 800; color: #fff; margin: 0 0 6px; }
  .pws-tier-moq { font-size: 13px; color: rgba(255,255,255,.5); margin: 0 0 20px; }
  .pws-tier-discount {
    font-size: 3rem;
    font-weight: 900;
    color: #fea910;
    line-height: 1;
    margin-bottom: 4px;
  }
  .pws-tier-discount-label { font-size: 13px; color: rgba(255,255,255,.55); margin-bottom: 24px; }
  .pws-tier-features {
    list-style: none; padding: 0; margin: 0 0 28px;
    text-align: left;
    display: flex; flex-direction: column; gap: 10px;
  }
  .pws-tier-features li {
    font-size: 13.5px;
    color: rgba(255,255,255,.75);
    display: flex; align-items: center; gap: 8px;
  }
  .pws-tier-features li::before {
    content: '✓';
    color: #fea910;
    font-weight: 800;
    flex-shrink: 0;
  }
  .pws-tier-cta {
    display: block;
    background: linear-gradient(90deg, #b84500, #de7200);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    font-size: 14px;
    padding: 13px 24px;
    border-radius: 10px;
    transition: opacity .2s, transform .18s;
  }
  .pws-tier-cta:hover { opacity: .9; transform: translateY(-1px); text-decoration: none; }
  .pws-tier-card--featured .pws-tier-cta { background: linear-gradient(90deg, #fea910, #ff9500); color: #0f1117; }

  /* ─── Products Grid ─────────────────────────────── */
  .pws-products {
    background: #fdf9f6;
    padding: 80px 24px;
  }
  .pws-products__inner { max-width: 1100px; margin: 0 auto; }
  .pws-products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 48px;
  }
  .pws-product-chip {
    background: #fff;
    border: 1.5px solid #f0e8e0;
    border-radius: 14px;
    padding: 20px 16px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: all .2s;
    display: block;
  }
  .pws-product-chip:hover {
    border-color: #b84500;
    box-shadow: 0 6px 24px rgba(184,69,0,.12);
    transform: translateY(-3px);
    text-decoration: none;
  }
  .pws-product-chip__icon { font-size: 30px; display: block; margin-bottom: 10px; }
  .pws-product-chip__name { font-size: 13.5px; font-weight: 700; color: #1a1a1a; display: block; margin-bottom: 4px; }
  .pws-product-chip__moq { font-size: 12px; color: #b84500; font-weight: 600; }

  /* ─── Form Section ──────────────────────────────── */
  .pws-form-section {
    background: #fff;
    padding: 80px 24px;
    border-top: 1px solid #f0e8e0;
  }
  .pws-form-section__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 460px;
    gap: 60px;
    align-items: center;
  }
  .pws-form-left__title {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 900;
    color: #1a1a1a;
    margin: 0 0 16px;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }
  .pws-form-left__sub { font-size: 15px; color: #555; line-height: 1.7; margin: 0 0 28px; }
  .pws-form-left__trust { display: flex; flex-direction: column; gap: 14px; }
  .pws-trust-item {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 18px;
    background: #fdf9f6;
    border-radius: 12px;
    border: 1px solid #f0e8e0;
  }
  .pws-trust-item__icon { font-size: 22px; flex-shrink: 0; }
  .pws-trust-item__text strong { display: block; font-size: 14px; font-weight: 700; color: #1a1a1a; }
  .pws-trust-item__text span  { font-size: 13px; color: #666; }

  /* Form panel */
  .pws-form-panel {
    background: #fff;
    border-radius: 20px;
    padding: 36px;
    box-shadow: 0 8px 48px rgba(0,0,0,.1);
    border: 1.5px solid #f0e8e0;
  }
  .pws-form-panel__title { font-size: 1.25rem; font-weight: 800; color: #1a1a1a; margin: 0 0 6px; }
  .pws-form-panel__sub { font-size: 13.5px; color: #777; margin: 0 0 28px; }
  .pws-field { position: relative; margin-bottom: 16px; }
  .pws-field label { display: block; font-size: 12.5px; font-weight: 700; color: #3a2010; margin-bottom: 6px; letter-spacing: .2px; }
  .pws-field label span { color: #b84500; }
  .pws-field input,
  .pws-field select,
  .pws-field textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid #e5d8ce;
    border-radius: 10px;
    font-size: 14px;
    font-family: inherit;
    color: #1a1a1a;
    background: #fff;
    transition: border-color .2s, box-shadow .2s;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
  }
  .pws-field input:focus,
  .pws-field select:focus,
  .pws-field textarea:focus {
    border-color: #b84500;
    box-shadow: 0 0 0 3px rgba(184,69,0,.1);
  }
  .pws-field textarea { resize: vertical; min-height: 100px; line-height: 1.6; }
  .pws-field select {
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 7L11 1' stroke='%23b84500' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' fill='none'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 14px center;
    padding-right: 40px;
  }
  .pws-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pws-submit-btn {
    width: 100%;
    background: linear-gradient(90deg, #b84500, #de7200);
    color: #fff;
    border: none;
    border-radius: 12px;
    padding: 15px 24px;
    font-size: 15px;
    font-weight: 800;
    font-family: inherit;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: opacity .2s, transform .18s;
    margin-top: 8px;
  }
  .pws-submit-btn:hover { opacity: .92; transform: translateY(-1px); }
  .pws-success-msg {
    background: #f0fdf4;
    border: 1.5px solid #86efac;
    border-radius: 12px;
    padding: 18px 22px;
    color: #166534;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 20px;
    display: flex; align-items: center; gap: 10px;
  }

  /* ─── FAQ ────────────────────────────────────────── */
  .pws-faq {
    background: #fdf9f6;
    padding: 80px 24px;
    border-top: 1px solid #f0e8e0;
  }
  .pws-faq__inner { max-width: 780px; margin: 0 auto; }
  .pws-faq__item { border-bottom: 1px solid #f0e8e0; }
  .pws-faq__item:last-child { border-bottom: none; }
  .pws-faq__q {
    width: 100%; background: none; border: none; text-align: left;
    padding: 18px 0; font-size: 15px; font-weight: 700; color: #1a1a1a;
    cursor: pointer; display: flex; justify-content: space-between;
    align-items: center; gap: 16px; font-family: inherit; transition: color .2s;
  }
  .pws-faq__q:hover, .pws-faq__q.open { color: #b84500; }
  .pws-faq__chevron {
    width: 22px; height: 22px;
    border: 2px solid currentColor; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; transition: transform .25s; font-size: 12px;
  }
  .pws-faq__q.open .pws-faq__chevron { transform: rotate(180deg); }
  .pws-faq__a {
    max-height: 0; overflow: hidden;
    transition: max-height .3s ease, padding .3s ease;
    font-size: 14px; color: #555; line-height: 1.75;
  }
  .pws-faq__a.open { max-height: 300px; padding-bottom: 18px; }
  .pws-faq__a a { color: #b84500; font-weight: 600; text-decoration: none; }
  .pws-faq__a a:hover { text-decoration: underline; }

  /* ─── CTA Strip ──────────────────────────────────── */
  .pws-cta {
    background: linear-gradient(135deg, #0f1117, #1e3a8a 50%, #b84500);
    padding: 64px 24px;
    text-align: center;
  }
  .pws-cta__inner { max-width: 640px; margin: 0 auto; }
  .pws-cta__title { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 900; color: #fff; margin: 0 0 12px; }
  .pws-cta__sub { font-size: 15px; color: rgba(255,255,255,.8); margin-bottom: 30px; line-height: 1.6; }
  .pws-cta__btns { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
  .pws-cta__btn {
    padding: 14px 28px; border-radius: 10px; font-size: 15px; font-weight: 800;
    text-decoration: none; transition: all .2s;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .pws-cta__btn:hover { transform: translateY(-2px); text-decoration: none; opacity: .92; }
  .pws-cta__btn--gold { background: #fea910; color: #0f1117; }
  .pws-cta__btn--wa   { background: #25d366; color: #fff; }

  /* ─── Responsive ─────────────────────────────────── */
  @media (max-width: 989px) {
    .pws-benefits-grid  { grid-template-columns: repeat(2, 1fr); }
    .pws-tiers-grid     { grid-template-columns: 1fr; max-width: 420px; margin: 52px auto 0; }
    .pws-tier-card--featured { transform: scale(1); }
    .pws-tier-card--featured:hover { transform: translateY(-5px); }
    .pws-products-grid  { grid-template-columns: repeat(2, 1fr); }
    .pws-steps          { grid-template-columns: 1fr; gap: 40px; }
    .pws-steps::before  { display: none; }
    .pws-form-section__inner { grid-template-columns: 1fr; }
    .pws-hero__stat     { padding: 0 20px; }
  }
  @media (max-width: 749px) {
    .pws-hero { padding: 60px 20px 80px; }
    .pws-hero__stats { gap: 20px; }
    .pws-hero__stat { border-right: none; border-bottom: 1px solid rgba(255,255,255,.12); padding: 16px 0; width: 50%; }
    .pws-hero__stat:nth-child(even) { border-right: none; }
    .pws-benefits-grid { grid-template-columns: 1fr; }
    .pws-products-grid { grid-template-columns: repeat(2, 1fr); }
    .pws-form-panel { padding: 24px 18px; }
    .pws-field-row { grid-template-columns: 1fr; }
    .pws-cta__btns { flex-direction: column; align-items: center; }
  }
</style>

<div class="pws-wrap">

  <!-- ═══ HERO ════════════════════════════════════════ -->
  <div class="pws-hero">
    <nav class="pws-hero__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a> ›
      <span>Wholesale</span>
    </nav>
    <div class="pws-hero__badge">🏷️ B2B &amp; Wholesale Program</div>
    <h1 class="pws-hero__title">
      Grow Your Business with<br>
      <span>Petaloons Wholesale</span>
    </h1>
    <p class="pws-hero__sub">
      India's #1 dog fashion brand is now open for wholesale partners. Stock premium dog outfits — lehengas, sherwanis, tuxedos, and more — at unbeatable bulk prices.
    </p>
    <div class="pws-hero__cta-group">
      <a href="#wholesale-form" class="pws-hero__cta pws-hero__cta--primary">
        🤝 Apply to Partner
      </a>
      <a href="https://wa.me/918625075493?text=Hi%20Petaloons!%20I%20am%20interested%20in%20your%20wholesale%20program." class="pws-hero__cta pws-hero__cta--outline" target="_blank" rel="noopener">
        💬 WhatsApp Us
      </a>
    </div>
    <div class="pws-hero__stats">
      <div class="pws-hero__stat">
        <span class="pws-hero__stat-val">200+</span>
        <span class="pws-hero__stat-label">Active Partners</span>
      </div>
      <div class="pws-hero__stat">
        <span class="pws-hero__stat-val">40%</span>
        <span class="pws-hero__stat-label">Max Discount</span>
      </div>
      <div class="pws-hero__stat">
        <span class="pws-hero__stat-val">10+</span>
        <span class="pws-hero__stat-label">Product Categories</span>
      </div>
      <div class="pws-hero__stat">
        <span class="pws-hero__stat-val">48hrs</span>
        <span class="pws-hero__stat-label">Onboarding Time</span>
