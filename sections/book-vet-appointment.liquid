        {"@type":"Question","name":"What is the consultation fee?","acceptedAnswer":{"@type":"Answer","text":"Fees vary by specialist and session length. All prices shown transparently before booking."}},
        {"@type":"Question","name":"Can I book emergency vet appointments?","acceptedAnswer":{"@type":"Answer","text":"Yes. Look for the green Available Now badge for immediate consultations, available 24/7."}}
      ]
    }
  ]
}
</script>

