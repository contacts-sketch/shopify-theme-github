  /* ---- State ---- */
  var state = { spec: 'All', search: '', page: 1, perPage: 12 };

  /* ---- DOM refs ---- */
  var grid      = document.getElementById('bva-doctors-grid');
  var countEl   = document.getElementById('bva-results-count');
  var loadMore  = document.getElementById('bva-load-more');
  var filterTabs = document.getElementById('bva-filter-tabs');
  var docSearch = document.getElementById('bva-doctor-search');

  /* ---- Helpers ---- */
  function getInitials(name) {
    return name.replace('Dr. ', '').split(' ').slice(0,2).map(function(w){ return w[0]; }).join('');
  }

  function getColor(id) {
    return AVATAR_COLORS[id % AVATAR_COLORS.length];
  }

  function availLabel(a) {
    if (a === 'now')   return '<span class="bva-doc-card__avail bva-doc-card__avail--now">● Available Now</span>';
    if (a === 'today') return '<span class="bva-doc-card__avail bva-doc-card__avail--today">● Available Today</span>';
    return '<span class="bva-doc-card__avail bva-doc-card__avail--busy">● Busy</span>';
  }

  function renderStars(r) {
    return '<span class="bva-doc-card__rating">' + r.toFixed(1) + ' ★</span>';
  }

  function buildCard(d) {
    var isBusy = d.avail === 'busy';
    /*
     * BOOKING INTEGRATION POINT:
     * Replace the href below with your actual booking URL.
     * Current: WhatsApp pre-filled message
     * Alt: '/pages/book?doctor=' + d.id
     */
    var bookUrl = 'https://wa.me/' + WHATSAPP_NUMBER +
      '?text=' + encodeURIComponent('Hi! I want to book an appointment with ' + d.name + ' (' + d.spec + ') on Petaloons.');

    return '<div class="bva-doc-card" role="listitem">' +
      '<div class="bva-doc-card__top">' +
        '<div class="bva-doc-card__avatar" style="background:' + getColor(d.id) + '">' + getInitials(d.name) + '</div>' +
        '<div class="bva-doc-card__meta">' +
          '<div class="bva-doc-card__name">' + d.name + '</div>' +
          '<div class="bva-doc-card__spec">' + d.spec + '</div>' +
        '</div>' +
      '</div>' +
      availLabel(d.avail) +
      '<div class="bva-doc-card__details">' +
        '<span class="bva-doc-card__detail">📍 ' + d.city + '</span>' +
        '<span class="bva-doc-card__detail">🩺 ' + d.exp + ' yrs</span>' +
        renderStars(d.rating) +
      '</div>' +
      '<div class="bva-doc-card__fee">₹' + d.fee + ' / session</div>' +
      (isBusy
        ? '<span class="bva-doc-card__book bva-doc-card__book--busy">Currently Busy</span>'
        : '<a href="' + bookUrl + '" target="_blank" rel="noopener" class="bva-doc-card__book">Book Now</a>') +
    '</div>';
  }

  function filteredDoctors() {
    return DOCTORS.filter(function (d) {
      var specOk   = state.spec === 'All' || d.spec === state.spec;
      var term     = state.search.toLowerCase().trim();
      var searchOk = !term || d.name.toLowerCase().includes(term) || d.city.toLowerCase().includes(term) || d.spec.toLowerCase().includes(term);
      return specOk && searchOk;
    });
  }

  function render() {
    var list   = filteredDoctors();
    var total  = list.length;
    var shown  = Math.min(state.page * state.perPage, total);
    var slice  = list.slice(0, shown);

    grid.innerHTML = slice.length
      ? slice.map(buildCard).join('')
      : '<div class="bva-no-results">No vets found matching your search. Try a different filter or keyword.</div>';

    countEl.textContent = 'Showing ' + shown + ' of ' + total + ' vet' + (total !== 1 ? 's' : '');
    loadMore.style.display = (shown < total) ? 'inline-flex' : 'none';
  }

  /* ---- Filter tabs ---- */
  filterTabs.addEventListener('click', function (e) {
    var tab = e.target.closest('.bva-filter-tab');
    if (!tab) return;
    filterTabs.querySelectorAll('.bva-filter-tab').forEach(function (t) {
      t.classList.remove('bva-filter-tab--active');
      t.setAttribute('aria-selected', 'false');
    });
    tab.classList.add('bva-filter-tab--active');
    tab.setAttribute('aria-selected', 'true');
    state.spec = tab.dataset.spec;
    state.page = 1;
    render();
  });

  /* ---- Doctor search ---- */
  docSearch.addEventListener('input', function () {
    state.search = this.value;
    state.page   = 1;
    render();
  });

  /* ---- Load More ---- */
  loadMore.addEventListener('click', function () {
    state.page++;
    render();
    /* Smooth scroll to newly added cards */
    var cards = grid.querySelectorAll('.bva-doc-card');
    if (cards.length > 0) {
      cards[Math.max(0, cards.length - state.perPage)].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });

  /* ---- Hero quick pills → scroll + filter ---- */
  document.querySelectorAll('.bva-quick-pill').forEach(function (pill) {
    pill.addEventListener('click', function () {
      var spec = this.dataset.spec;
      /* Activate matching filter tab */
      filterTabs.querySelectorAll('.bva-filter-tab').forEach(function (t) {
        t.classList.toggle('bva-filter-tab--active', t.dataset.spec === spec);
        t.setAttribute('aria-selected', t.dataset.spec === spec ? 'true' : 'false');
      });
      state.spec = spec;
      state.page = 1;
      render();
      document.getElementById('bva-doctors').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  /* ---- Hero search bar ---- */
  var heroSearch = document.getElementById('bva-hero-search');
  var heroBtn    = document.getElementById('bva-hero-search-btn');

  function doHeroSearch() {
    var val = heroSearch.value.trim();
    if (!val) {
      document.getElementById('bva-doctors').scrollIntoView({ behavior:'smooth', block:'start' });
      return;
    }
    state.search = val;
    state.spec   = 'All';
    state.page   = 1;
    /* Reset filter tabs */
    filterTabs.querySelectorAll('.bva-filter-tab').forEach(function (t) {
      t.classList.toggle('bva-filter-tab--active', t.dataset.spec === 'All');
    });
    docSearch.value = val;
    render();
    document.getElementById('bva-doctors').scrollIntoView({ behavior:'smooth', block:'start' });
  }

  heroBtn.addEventListener('click', doHeroSearch);
  heroSearch.addEventListener('keydown', function (e) { if (e.key === 'Enter') doHeroSearch(); });

  /* ---- Smooth scroll for .bva-scroll-to links ---- */
  document.querySelectorAll('.bva-scroll-to').forEach(function (el) {
    el.addEventListener('click', function (e) {
      var target = document.querySelector(this.getAttribute('href'));
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior:'smooth', block:'start' }); }
    });
  });

  /* ---- FAQ accordion ---- */
  document.querySelectorAll('.bva-faq-q').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var item   = this.closest('.bva-faq-item');
      var isOpen = item.classList.contains('bva-faq-item--open');
      document.querySelectorAll('.bva-faq-item').forEach(function (el) {
        el.classList.remove('bva-faq-item--open');
        el.querySelector('.bva-faq-q').setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) { item.classList.add('bva-faq-item--open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });

  /* ---- Initial render ---- */
  render();

})();
</script>


