{%- comment -%}
  SEO NOTE — Set in Shopify Admin › Pages › Book Vet Appointment › SEO:
  Title       : Book Vet Appointment Online for Your Pet | Petaloons
  Description : Book online vet appointments for dogs, cats & all pets on Petaloons.
                Consult certified veterinarians from home — general care, vaccinations,
                dermatology, surgery & more. Affordable, fast & trusted.
  Handle      : book-vet-appointment
{%- endcomment -%}

<!-- ── Structured Data: FAQPage + MedicalOrganization ── -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalOrganization",
      "name": "Petaloons Vet Consultation",
      "url": "{{ shop.url }}/pages/book-vet-appointment",
      "description": "Book online vet appointments for pets. Certified veterinarians available for dogs, cats and all pets.",
      "medicalSpecialty": ["Veterinary","GeneralPractice","Surgery","Dermatology","Dentistry"],
      "availableService": {
        "@type": "MedicalTherapy",
        "name": "Online Veterinary Consultation"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I book a vet appointment online on Petaloons?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Simply browse our verified vets, choose a specialist, pick a time slot, and confirm your booking. The entire process takes under 2 minutes."
          }
        },
        {
          "@type": "Question",
          "name": "Are Petaloons veterinarians certified?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Every vet on Petaloons is a licensed professional verified by our team. All hold valid veterinary practice licences."
          }
        },
        {
          "@type": "Question",
          "name": "Which pets are covered for online vet consultation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We cover dogs, cats, birds, rabbits, and small animals. Exotic pet specialists are also available on request."
          }
        },
        {
          "@type": "Question",
          "name": "Can I get a prescription from an online vet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, our licensed vets can issue digital prescriptions for most non-emergency conditions during the online consultation."
          }
        },
        {
          "@type": "Question",
          "name": "What is the cost of an online vet consultation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Consultation fees vary by specialist and duration. Prices are displayed transparently on each vet's profile before you book."
          }
        },
        {
          "@type": "Question",
          "name": "Can I book emergency vet appointments?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We have emergency-available vets for urgent situations. Look for the 'Available Now' badge on vet profiles for immediate consultations."
          }
        }
      ]
    }
  ]
}
</script>

