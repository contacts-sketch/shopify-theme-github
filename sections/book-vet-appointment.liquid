<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalOrganization",
      "name": "Petaloons Vet Consultation",
      "url": "{{ shop.url }}/pages/book-vet-appointment",
      "description": "Book online vet appointments for pets. Certified veterinarians available for dogs, cats and all pets.",
      "medicalSpecialty": ["Veterinary","GeneralPractice","Surgery","Dermatology","Dentistry"]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"How do I book a vet appointment online on Petaloons?","acceptedAnswer":{"@type":"Answer","text":"Browse our verified vets, pick a specialist, choose a time slot and confirm your booking in under 2 minutes."}},
