<script>
(function () {
  'use strict';

  /* FAQ accordion */
  document.querySelectorAll('.bva-faq-q').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var item = this.closest('.bva-faq-item');
      var isOpen = item.classList.contains('bva-faq-item--open');
      /* Close all */
      document.querySelectorAll('.bva-faq-item').forEach(function (el) {
        el.classList.remove('bva-faq-item--open');
        el.querySelector('.bva-faq-q').setAttribute('aria-expanded', 'false');
      });
      /* Open clicked if it was closed */
      if (!isOpen) {
        item.classList.add('bva-faq-item--open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  /* Search bar — redirect to vet collection on Enter */
  var searchInput = document.getElementById('bva-search-input');
  if (searchInput) {
    searchInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        window.location.href = '/collections/doctors-for-veterinary-services';
      }
    });
  }

})();
</script>


