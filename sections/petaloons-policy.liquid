<script>
  // FAQ accordion
  document.querySelectorAll('.ppol-faq__q').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var ans = btn.nextElementSibling;
      var isOpen = btn.classList.contains('open');
      btn.closest('.ppol-faq').querySelectorAll('.ppol-faq__q').forEach(function(b){ b.classList.remove('open'); b.setAttribute('aria-expanded','false'); });
      btn.closest('.ppol-faq').querySelectorAll('.ppol-faq__a').forEach(function(a){ a.classList.remove('open'); });
      if (!isOpen) {
        btn.classList.add('open');
        btn.setAttribute('aria-expanded','true');
        ans.classList.add('open');
      }
    });
  });

  // Smooth scroll for TOC links
  document.querySelectorAll('.ppol-toc a[href^="#"]').forEach(function(link) {
    link.addEventListener('click', function(e) {
      var target = document.querySelector(link.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>

