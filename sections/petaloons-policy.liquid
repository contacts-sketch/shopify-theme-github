{% comment %}
  Petaloons Policy Page — Beautiful branded wrapper for all policy pages
  Shipping / Refund / Privacy / Terms of Service
  CSS scope: .ppol-*
  URLs: /policies/shipping-policy, /policies/refund-policy, etc.
{% endcomment %}

{%- liquid
  assign is_shipping = false
  assign is_refund    = false
  assign is_privacy   = false
  assign is_terms     = false

  if policy.title contains 'Shipping'
    assign is_shipping = true
  elsif policy.title contains 'Refund' or policy.title contains 'Return'
    assign is_refund = true
  elsif policy.title contains 'Privacy'
    assign is_privacy = true
  elsif policy.title contains 'Terms'
    assign is_terms = true
  endif

  if is_shipping
    assign hero_icon  = '🚚'
    assign hero_color = '#5a1d00'
    assign hero_sub   = 'Everything you need to know about how we get your pup\'s outfits to your doorstep — fast, safe, and with love.'
  elsif is_refund
    assign hero_icon  = '🔄'
    assign hero_color = '#1d3a5a'
    assign hero_sub   = 'Not happy? We\'ll make it right. Our hassle-free return & refund policy is designed with you in mind.'
  elsif is_privacy
    assign hero_icon  = '🔒'
    assign hero_color = '#1a3320'
    assign hero_sub   = 'Your privacy matters. Here\'s exactly how we collect, use, and protect your personal information.'
  else
    assign hero_icon  = '📄'
    assign hero_color = '#2d1a40'
    assign hero_sub   = 'Please read this policy carefully. By using Petaloons, you agree to these terms.'
  endif
-%}

<style>
  .ppol-wrap * { box-sizing: border-box; }
  .ppol-wrap { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1a1a1a; }

  /* ─── Hero ─────────────────────────────────────── */
  .ppol-hero {
    position: relative;
    background: linear-gradient(135deg, {{ hero_color }} 0%, #b84500 55%, #de7200 100%);
    padding: 68px 24px 80px;
    text-align: center;
    overflow: hidden;
  }
  .ppol-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Ccircle cx='30' cy='30' r='4'/%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }
  .ppol-hero__breadcrumb {
    position: relative;
    font-size: 13px;
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
  }
  .ppol-hero__breadcrumb a { color: rgba(255,255,255,0.85); text-decoration: none; }
  .ppol-hero__breadcrumb a:hover { color: #fff; text-decoration: underline; }
  .ppol-hero__icon {
    position: relative;
    font-size: 52px;
    line-height: 1;
    margin-bottom: 16px;
    display: block;
  }
  .ppol-hero__eyebrow {
    position: relative;
    display: inline-block;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.3);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    padding: 6px 18px;
    border-radius: 30px;
    margin-bottom: 16px;
  }
  .ppol-hero__title {
    position: relative;
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    font-weight: 900;
    color: #fff;
    margin: 0 0 14px;
    line-height: 1.1;
    letter-spacing: -0.8px;
  }
  .ppol-hero__sub {
    position: relative;
    font-size: 1rem;
    color: rgba(255,255,255,0.88);
    max-width: 560px;
    margin: 0 auto 28px;
    line-height: 1.65;
  }
  .ppol-hero__meta {
    position: relative;
    font-size: 12.5px;
    color: rgba(255,255,255,0.6);
  }
  .ppol-hero__wave {
    position: absolute;
    bottom: -2px; left: 0;
    width: 100%; line-height: 0;
  }

  /* ─── Stat Cards (Shipping only) ────────────────── */
  .ppol-stats-section {
    background: #fff;
    padding: 0 24px;
  }
  .ppol-stats {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    transform: translateY(-44px);
  }
  .ppol-stat-card {
    background: #fff;
    border-radius: 16px;
    padding: 24px 20px;
    box-shadow: 0 6px 32px rgba(0,0,0,0.09);
    text-align: center;
    border: 1.5px solid #f0e8e0;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .ppol-stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(184,69,0,0.13);
    border-color: #b84500;
  }
  .ppol-stat-card__icon {
    font-size: 30px;
    margin-bottom: 10px;
    display: block;
  }
  .ppol-stat-card__val {
    font-size: 1.35rem;
    font-weight: 900;
    color: #b84500;
    margin-bottom: 4px;
    line-height: 1.2;
  }
  .ppol-stat-card__label {
    font-size: 12.5px;
    color: #666;
    font-weight: 600;
  }

  /* ─── Main Layout ────────────────────────────────── */
  .ppol-body {
    background: #fdf9f6;
    padding: 0 24px 80px;
  }
  .ppol-body__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 40px;
    align-items: start;
  }

  /* ─── Sticky Sidebar ─────────────────────────────── */
  .ppol-sidebar { position: sticky; top: 100px; }
  .ppol-sidebar-card {
    background: #fff;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    border: 1px solid #f0e8e0;
    margin-bottom: 20px;
  }
  .ppol-sidebar-card__title {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #b84500;
    margin: 0 0 16px;
    padding-bottom: 10px;
    border-bottom: 2px solid #f0e8e0;
  }
  .ppol-toc { list-style: none; padding: 0; margin: 0; }
  .ppol-toc li {
    border-bottom: 1px solid #f5ede6;
    padding: 0;
  }
  .ppol-toc li:last-child { border-bottom: none; }
  .ppol-toc a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 0;
    font-size: 13.5px;
    color: #444;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s, padding-left 0.2s;
  }
  .ppol-toc a:hover { color: #b84500; padding-left: 6px; }
  .ppol-toc a::before {
    content: '›';
    color: #b84500;
    font-weight: 700;
    font-size: 16px;
    line-height: 1;
    flex-shrink: 0;
  }

  /* Support card */
  .ppol-support-card {
    background: linear-gradient(135deg, #b84500, #de7200);
    border-radius: 16px;
    padding: 24px;
    color: #fff;
    text-align: center;
  }
  .ppol-support-card__icon { font-size: 32px; margin-bottom: 10px; }
  .ppol-support-card__title { font-size: 15px; font-weight: 800; margin-bottom: 8px; }
  .ppol-support-card__text { font-size: 13px; opacity: 0.9; margin-bottom: 16px; line-height: 1.5; }
  .ppol-support-card__btn {
    display: block;
    background: #fff;
    color: #b84500;
    text-decoration: none;
    font-weight: 800;
    font-size: 13.5px;
    padding: 10px 20px;
    border-radius: 30px;
    transition: opacity 0.2s;
  }
  .ppol-support-card__btn:hover { opacity: 0.9; text-decoration: none; }
  .ppol-support-card__wa {
    display: block;
    background: #25d366;
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    font-size: 13px;
    padding: 9px 20px;
    border-radius: 30px;
    margin-top: 8px;
    transition: opacity 0.2s;
  }
  .ppol-support-card__wa:hover { opacity: 0.9; text-decoration: none; }

  /* ─── Main Content ───────────────────────────────── */
  .ppol-content { }

  /* Shipping timeline */
  .ppol-timeline {
    background: #fff;
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    border: 1px solid #f0e8e0;
    margin-bottom: 28px;
  }
  .ppol-timeline__title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0 0 28px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ppol-timeline__steps {
    display: flex;
    align-items: flex-start;
    gap: 0;
    position: relative;
  }
  .ppol-timeline__step {
    flex: 1;
    text-align: center;
    position: relative;
    padding: 0 8px;
  }
  .ppol-timeline__step::before {
    content: '';
    position: absolute;
    top: 22px;
    left: calc(50% + 22px);
    width: calc(100% - 44px);
    height: 2px;
    background: linear-gradient(90deg, #b84500, #de7200);
    z-index: 0;
  }
  .ppol-timeline__step:last-child::before { display: none; }
  .ppol-step-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #b84500, #de7200);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    margin: 0 auto 10px;
    position: relative;
    z-index: 1;
    box-shadow: 0 4px 12px rgba(184,69,0,0.3);
  }
  .ppol-step-label {
    font-size: 12px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 3px;
    line-height: 1.3;
  }
  .ppol-step-time {
    font-size: 11px;
    color: #888;
    line-height: 1.3;
  }

  /* Zones table */
  .ppol-zones {
    background: #fff;
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    border: 1px solid #f0e8e0;
    margin-bottom: 28px;
    overflow-x: auto;
  }
  .ppol-zones__title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0 0 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ppol-zones table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    min-width: 480px;
  }
  .ppol-zones thead tr {
    background: linear-gradient(90deg, #b84500, #de7200);
    color: #fff;
  }
  .ppol-zones thead th {
    padding: 13px 16px;
    text-align: left;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.3px;
  }
  .ppol-zones thead th:first-child { border-radius: 10px 0 0 0; }
  .ppol-zones thead th:last-child  { border-radius: 0 10px 0 0; }
  .ppol-zones tbody tr { border-bottom: 1px solid #f0e8e0; transition: background 0.15s; }
  .ppol-zones tbody tr:last-child { border-bottom: none; }
  .ppol-zones tbody tr:hover { background: #fff8f4; }
  .ppol-zones tbody td { padding: 13px 16px; color: #333; vertical-align: middle; }
  .ppol-zones tbody td:first-child { font-weight: 700; color: #1a1a1a; }
  .ppol-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
  }
  .ppol-badge--free  { background: #dcfce7; color: #166534; }
  .ppol-badge--paid  { background: #fff7ed; color: #9a3412; }
  .ppol-badge--fast  { background: #eff6ff; color: #1d4ed8; }

  /* Policy body content */
  .ppol-policy-body {
    background: #fff;
    border-radius: 20px;
    padding: 36px 40px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    border: 1px solid #f0e8e0;
    margin-bottom: 28px;
  }
  .ppol-policy-body__title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0 0 24px;
    padding-bottom: 16px;
    border-bottom: 2px solid #f0e8e0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ppol-policy-body__content { font-size: 14.5px; color: #444; line-height: 1.8; }
  .ppol-policy-body__content h1,
  .ppol-policy-body__content h2 { font-size: 1.1rem; font-weight: 800; color: #1a1a1a; margin: 24px 0 10px; }
  .ppol-policy-body__content h3 { font-size: 1rem; font-weight: 700; color: #3a1a00; margin: 18px 0 8px; }
  .ppol-policy-body__content p  { margin: 0 0 14px; }
  .ppol-policy-body__content ul,
  .ppol-policy-body__content ol { padding-left: 20px; margin: 0 0 14px; }
  .ppol-policy-body__content li { margin-bottom: 6px; }
  .ppol-policy-body__content a  { color: #b84500; font-weight: 600; text-decoration: none; }
  .ppol-policy-body__content a:hover { text-decoration: underline; }
  .ppol-policy-body__content strong { color: #1a1a1a; }

  /* ─── FAQ ────────────────────────────────────────── */
  .ppol-faq {
    background: #fff;
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    border: 1px solid #f0e8e0;
    margin-bottom: 28px;
  }
  .ppol-faq__title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0 0 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ppol-faq__item { border-bottom: 1px solid #f0e8e0; }
  .ppol-faq__item:last-child { border-bottom: none; }
  .ppol-faq__q {
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    padding: 16px 0;
    font-size: 14.5px;
    font-weight: 700;
    color: #1a1a1a;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-family: inherit;
    transition: color 0.2s;
  }
  .ppol-faq__q:hover, .ppol-faq__q.open { color: #b84500; }
  .ppol-faq__chevron {
    width: 22px; height: 22px;
    border: 2px solid currentColor;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.25s;
    font-size: 12px;
  }
  .ppol-faq__q.open .ppol-faq__chevron { transform: rotate(180deg); }
  .ppol-faq__a {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    font-size: 14px;
    color: #555;
    line-height: 1.7;
  }
  .ppol-faq__a.open { max-height: 300px; padding-bottom: 18px; }

  /* ─── CTA Strip ──────────────────────────────────── */
  .ppol-cta {
    background: linear-gradient(135deg, #5a1d00, #b84500);
    padding: 52px 24px;
    text-align: center;
    margin-top: 0;
  }
  .ppol-cta__inner { max-width: 600px; margin: 0 auto; }
  .ppol-cta__title { font-size: 1.6rem; font-weight: 900; color: #fff; margin: 0 0 10px; }
  .ppol-cta__sub { font-size: 15px; color: rgba(255,255,255,0.85); margin-bottom: 28px; line-height: 1.6; }
  .ppol-cta__btns { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
  .ppol-cta__btn {
    padding: 14px 28px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.18s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .ppol-cta__btn:hover { opacity: 0.9; transform: translateY(-2px); text-decoration: none; }
  .ppol-cta__btn--primary { background: #fff; color: #b84500; }
  .ppol-cta__btn--wa { background: #25d366; color: #fff; }

  /* ─── Responsive ─────────────────────────────────── */
  @media (max-width: 989px) {
    .ppol-stats { grid-template-columns: repeat(2, 1fr); transform: translateY(-28px); }
    .ppol-body__inner { grid-template-columns: 1fr; }
    .ppol-sidebar { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .ppol-timeline__steps { flex-wrap: wrap; gap: 20px; justify-content: center; }
    .ppol-timeline__step::before { display: none; }
  }
  @media (max-width: 749px) {
    .ppol-hero { padding: 52px 20px 64px; }
    .ppol-stats { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .ppol-body { padding: 0 16px 60px; }
    .ppol-policy-body { padding: 24px 20px; }
    .ppol-sidebar { grid-template-columns: 1fr; }
    .ppol-cta__btns { flex-direction: column; align-items: center; }
    .ppol-timeline__step { flex: 0 0 calc(50% - 10px); }
  }
  @media (max-width: 480px) {
    .ppol-stats { grid-template-columns: 1fr 1fr; }
  }
</style>

<div class="ppol-wrap">

  <!-- ═══ HERO ═══════════════════════════════════════ -->
  <div class="ppol-hero">
    <nav class="ppol-hero__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a> ›
      <span>{{ policy.title }}</span>
    </nav>
    <span class="ppol-hero__icon" aria-hidden="true">{{ hero_icon }}</span>
    <div class="ppol-hero__eyebrow">📋 Petaloons Policies</div>
    <h1 class="ppol-hero__title">{{ policy.title }}</h1>
    <p class="ppol-hero__sub">{{ hero_sub }}</p>
    <p class="ppol-hero__meta">Last updated: {{ 'now' | date: '%B %Y' }}</p>
    <div class="ppol-hero__wave">
      <svg viewBox="0 0 1440 48" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0 48L1440 48L1440 12C1200 44 960 4 720 20C480 36 240 0 0 12L0 48Z" fill="#fdf9f6"/>
      </svg>
    </div>
  </div>

  <!-- ═══ STAT CARDS (Shipping only) ════════════════ -->
  {%- if is_shipping -%}
  <div class="ppol-stats-section">
    <div class="ppol-stats">
      <div class="ppol-stat-card">
        <span class="ppol-stat-card__icon">🎁</span>
        <div class="ppol-stat-card__val">FREE</div>
        <div class="ppol-stat-card__label">Shipping above ₹999</div>
      </div>
      <div class="ppol-stat-card">
        <span class="ppol-stat-card__icon">📅</span>
        <div class="ppol-stat-card__val">3–7 Days</div>
        <div class="ppol-stat-card__label">Standard Delivery</div>
      </div>
      <div class="ppol-stat-card">
        <span class="ppol-stat-card__icon">⚡</span>
        <div class="ppol-stat-card__val">1–3 Days</div>
        <div class="ppol-stat-card__label">Express Delivery</div>
      </div>
      <div class="ppol-stat-card">
        <span class="ppol-stat-card__icon">🇮🇳</span>
        <div class="ppol-stat-card__val">Pan-India</div>
        <div class="ppol-stat-card__label">Ships everywhere in India</div>
      </div>
    </div>
  </div>
  {%- else -%}
  <div style="height: 48px; background: #fdf9f6;"></div>
  {%- endif -%}

  <!-- ═══ MAIN BODY ═══════════════════════════════════ -->
  <div class="ppol-body">
    <div class="ppol-body__inner">

      <!-- Main Content -->
      <div class="ppol-content">

        {%- if is_shipping -%}

        <!-- Shipping Timeline -->
        <div class="ppol-timeline" id="how-it-works">
          <div class="ppol-timeline__title">📦 How Your Order Reaches You</div>
          <div class="ppol-timeline__steps">
            <div class="ppol-timeline__step">
              <div class="ppol-step-icon">🛒</div>
              <div class="ppol-step-label">Order Placed</div>
              <div class="ppol-step-time">Day 0</div>
            </div>
            <div class="ppol-timeline__step">
              <div class="ppol-step-icon">✅</div>
              <div class="ppol-step-label">Order Confirmed</div>
              <div class="ppol-step-time">Within 2 hrs</div>
            </div>
            <div class="ppol-timeline__step">
              <div class="ppol-step-icon">🧵</div>
              <div class="ppol-step-label">Packed with Love</div>
              <div class="ppol-step-time">Day 1–2</div>
            </div>
            <div class="ppol-timeline__step">
              <div class="ppol-step-icon">🚚</div>
              <div class="ppol-step-label">Dispatched</div>
              <div class="ppol-step-time">Day 2–3</div>
            </div>
            <div class="ppol-timeline__step">
              <div class="ppol-step-icon">🏠</div>
              <div class="ppol-step-label">Delivered!</div>
              <div class="ppol-step-time">Day 3–7</div>
            </div>
          </div>
        </div>

        <!-- Delivery Zones Table -->
        <div class="ppol-zones" id="delivery-zones">
          <div class="ppol-zones__title">🗺️ Delivery Zones & Estimated Timelines</div>
          <table aria-label="Delivery zones and shipping costs">
            <thead>
              <tr>
                <th>Zone</th>
                <th>Cities / Areas</th>
                <th>Standard</th>
                <th>Express</th>
                <th>Shipping Cost</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Metro Cities</td>
                <td>Mumbai, Delhi, Bangalore, Chennai, Hyderabad, Kolkata, Pune</td>
                <td>3–4 days</td>
                <td>1–2 days</td>
                <td>
                  <span class="ppol-badge ppol-badge--free">✓ Free above ₹999</span>
                </td>
              </tr>
              <tr>
                <td>Tier-1 Cities</td>
