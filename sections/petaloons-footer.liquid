}

.pft-newsletter-bar__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}

.pft-newsletter-bar__text {
  display: flex;
  align-items: center;
  gap: 14px;
  color: #fff;
}

.pft-newsletter-bar__icon { font-size: 28px; flex-shrink: 0; }

.pft-newsletter-bar__text strong {
  display: block;
  font-size: 16px;
  font-weight: 700;
}

.pft-newsletter-bar__text span {
  font-size: 13px;
  opacity: .8;
}

.pft-newsletter-form { display: flex; flex-direction: column; gap: 6px; }

.pft-newsletter-fields {
  display: flex;
  gap: 8px;
  align-items: center;
}

.pft-newsletter-input {
  border: none;
  border-radius: 40px;
  padding: 11px 20px;
  font-size: 14px;
  font-family: inherit;
  background: rgba(255,255,255,.15);
  color: #fff;
  outline: none;
  width: 240px;
  transition: background .2s;
}

.pft-newsletter-input::placeholder { color: rgba(255,255,255,.55); }
.pft-newsletter-input:focus { background: rgba(255,255,255,.22); }

.pft-newsletter-btn {
  background: #fea910;
  color: #121212;
  border: none;
  border-radius: 40px;
  padding: 11px 24px;
  font-size: 14px;
  font-weight: 700;
  font-family: inherit;
  cursor: pointer;
  white-space: nowrap;
  transition: background .18s, transform .15s;
}

.pft-newsletter-btn:hover { background: #ffbe3d; transform: translateY(-1px); }
.pft-newsletter-success { color: #bbf7d0; font-size: 14px; font-weight: 600; margin: 0; }
.pft-newsletter-error { color: #fca5a5; font-size: 12px; margin: 0; }

/* ── Main body ── */
.pft-body { padding: 60px 0 48px; border-bottom: 1px solid rgba(255,255,255,.07); }

.pft-grid {
  display: grid;
  grid-template-columns: 1.6fr 1.2fr 1.4fr 1.2fr;
  gap: 48px;
}

/* ── Brand column ── */
.pft-logo { max-width: 120px; height: auto; filter: brightness(0) invert(1); }
.pft-brand-name { font-size: 22px; font-weight: 800; color: #fff; text-decoration: none; }
.pft-logo-link { display: inline-block; margin-bottom: 16px; }

.pft-tagline {
  font-size: 14px;
  color: rgba(255,255,255,.55);
  margin: 0 0 20px;
  line-height: 1.7;
}

.pft-social {
  display: flex;
  gap: 10px;
  margin-bottom: 24px;
}

.pft-social-link {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,.7);
  text-decoration: none;
  transition: background .18s, color .18s, transform .15s;
}

.pft-social-link:hover {
  background: #fea910;
  border-color: #fea910;
  color: #121212;
  transform: translateY(-2px);
}

.pft-trust-badges {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.pft-trust-badge {
  font-size: 12.5px;
  color: rgba(255,255,255,.5);
  display: flex;
  align-items: center;
  gap: 8px;
}

.pft-trust-badge span { font-size: 16px; }

/* ── Link columns ── */
.pft-col__heading {
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: #fff;
  margin: 0 0 18px;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.pft-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.pft-link {
