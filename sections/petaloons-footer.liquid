  color: rgba(255,255,255,.55);
  text-decoration: none;
  transition: color .18s, padding-left .18s;
  display: block;
}

.pft-link:hover { color: #fea910; padding-left: 4px; }
.pft-link--highlight { color: #fea910 !important; font-weight: 600; }
.pft-link--highlight:hover { color: #ffbe3d !important; }

/* ── Why Petaloons features ── */
.pft-features {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.pft-feature {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.pft-feature__icon {
  font-size: 20px;
  flex-shrink: 0;
  margin-top: 2px;
}

.pft-feature strong {
  display: block;
  font-size: 13.5px;
  color: #fff;
  margin-bottom: 3px;
}

.pft-feature p {
  font-size: 12.5px;
  color: rgba(255,255,255,.45);
  margin: 0;
  line-height: 1.5;
}

/* ── Bottom bar ── */
.pft-bottom {
  padding: 20px 0;
  background: rgba(0,0,0,.25);
}

.pft-bottom__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.pft-bottom__left {
  font-size: 12.5px;
  color: rgba(255,255,255,.35);
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.pft-bottom__brand {
  color: rgba(255,255,255,.55);
  text-decoration: none;
  font-weight: 600;
}

.pft-bottom__brand:hover { color: #fea910; }
.pft-bottom__sep { color: rgba(255,255,255,.2); }

.pft-bottom__center {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
}

.pft-bottom__link {
  font-size: 12px;
  color: rgba(255,255,255,.35);
  text-decoration: none;
  transition: color .18s;
}

.pft-bottom__link:hover { color: rgba(255,255,255,.75); }

/* ── Payment icons ── */
.pft-payments {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pft-payments__label {
  font-size: 11px;
  color: rgba(255,255,255,.3);
  text-transform: uppercase;
  letter-spacing: .06em;
  white-space: nowrap;
}

.pft-payments__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  align-items: center;
}

.pft-payments__item {
  height: 24px;
  display: flex;
  align-items: center;
}

.pft-payments__icon {
  height: 24px;
  width: auto;
  border-radius: 4px;
  opacity: .8;
  transition: opacity .18s;
}

.pft-payments__icon:hover { opacity: 1; }

/* ── Responsive ── */
@media (max-width: 1024px) {
  .pft-grid { grid-template-columns: 1fr 1fr; gap: 36px; }
  .pft-col--brand { grid-column: 1 / -1; }
  .pft-trust-badges { flex-direction: row; flex-wrap: wrap; gap: 16px; }
}

@media (max-width: 640px) {
  .pft-grid { grid-template-columns: 1fr; gap: 28px; }
  .pft-col--brand { grid-column: auto; }
  .pft-newsletter-bar__inner { flex-direction: column; align-items: flex-start; }
  .pft-newsletter-input { width: 100%; }
  .pft-newsletter-fields { flex-direction: column; }
  .pft-newsletter-btn { width: 100%; }
  .pft-bottom__inner { flex-direction: column; align-items: flex-start; gap: 14px; }
  .pft-bottom__center { gap: 12px; }
  .pft-payments { flex-direction: column; align-items: flex-start; gap: 8px; }
