</section>

<!-- ══ STATS BAND ══ -->
<section class="pab-section pab-section--dark" aria-label="Petaloons by the numbers">
  <div class="pab-inner">
    <div class="pab-section-header pab-section-header--center">
      <div class="pab-section-label">🏆 Petaloons by the Numbers</div>
