  <!-- TRUST CARDS -->
  <div class="pbreed-trust">
    <div class="pbreed-trust__inner">
      <div class="pbreed-trust-card">
        <span class="pbreed-trust-card__icon">📐</span>
        <div class="pbreed-trust-card__val">{{ typical_size }}</div>
