      </div>
      <div class="pbreed-trust-card">
        <span class="pbreed-trust-card__icon">🎁</span>
        <div class="pbreed-trust-card__val">Free Shipping</div>
        <div class="pbreed-trust-card__label">Orders above ₹999</div>
      </div>
      <div class="pbreed-trust-card">
        <span class="pbreed-trust-card__icon">🇮🇳</span>
        <div class="pbreed-trust-card__val">Made in India</div>
        <div class="pbreed-trust-card__label">Handcrafted outfits</div>
      </div>
      <div class="pbreed-trust-card">
