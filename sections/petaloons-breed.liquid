{%- comment -%}
  Petaloons Breed-Specific Landing Page
  CSS scope: .pbr-*
  URL pattern: /pages/dog-clothes-for-[breed-handle]
  Configure each breed page via section settings in the theme editor.
{%- endcomment -%}

{%- assign breed_name    = section.settings.breed_name | default: 'Golden Retriever' -%}
{%- assign breed_handle  = breed_name | handleize -%}
{%- assign breed_size    = section.settings.breed_size | default: 'L–XXL' -%}
{%- assign breed_weight  = section.settings.breed_weight | default: '25–40 kg' -%}
{%- assign breed_blurb   = section.settings.breed_blurb | default: 'Friendly, energetic and always camera-ready — Golden Retrievers love dressing up for every occasion.' -%}
{%- assign breed_emoji   = section.settings.breed_emoji | default: '🐕' -%}
{%- assign breed_tag     = section.settings.breed_tag | default: '' -%}

{%- comment -%} Size chart rows from settings {%- endcomment -%}
{%- assign sz_chest   = section.settings.sz_chest   | default: '60–72 cm' -%}
{%- assign sz_neck    = section.settings.sz_neck    | default: '42–50 cm' -%}
{%- assign sz_back    = section.settings.sz_back    | default: '52–62 cm' -%}
{%- assign sz_recommended = section.settings.sz_recommended | default: 'L / XL' -%}

{%- comment -%} Collections {%- endcomment -%}
{%- assign lehenga_col  = collections['dog-lehengas'] -%}
{%- assign sherwani_col = collections['dog-sherwani-collection-india'] -%}
{%- assign tshirt_col   = collections['dog-t-shirts'] -%}

<!-- ══ STRUCTURED DATA ══ -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "{{ shop.url }}{{ page.url }}#webpage",
      "url": "{{ shop.url }}{{ page.url }}",
      "name": "Dog Clothes for {{ breed_name }} — Lehenga, Sherwani & T-Shirts | Petaloons",
      "description": "Shop handcrafted dog lehenga, dog sherwani and dog t-shirts for {{ breed_name }}. Size guide, styling tips and curated outfits for {{ breed_name }} dogs. Pan-India delivery.",
      "isPartOf": { "@id": "{{ shop.url }}/#website" },
      "about": { "@id": "{{ shop.url }}/#organization" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ shop.url }}" },
          { "@type": "ListItem", "position": 2, "name": "Breeds", "item": "{{ shop.url }}/pages/dog-breed-guides" },
          { "@type": "ListItem", "position": 3, "name": "{{ breed_name }}", "item": "{{ shop.url }}{{ page.url }}" }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What size dog clothes does a {{ breed_name }} need?",
          "acceptedAnswer": { "@type": "Answer", "text": "Most {{ breed_name }} dogs fit {{ sz_recommended }} in the Petaloons size chart. Measure your dog's chest girth ({{ sz_chest }}), neck ({{ sz_neck }}) and back length ({{ sz_back }}) for the perfect fit. Always check the size guide on each product page." }
        },
        {
          "@type": "Question",
          "name": "Which Petaloons outfits are best for a {{ breed_name }}?",
          "acceptedAnswer": { "@type": "Answer", "text": "Golden Retrievers and large breeds look stunning in our Dog Lehenga and Dog Sherwani for weddings and festivals. Our Dog T-Shirts are perfect for casual everyday wear. All styles are available in sizes that fit {{ breed_name }} dogs." }
        },
        {
          "@type": "Question",
          "name": "Are Petaloons dog clothes safe for {{ breed_name }} dogs?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes! All Petaloons outfits use pet-safe, breathable fabrics with non-toxic dyes — tested by real dog parents. They are designed for comfort and full range of motion so your {{ breed_name }} can move freely." }
        },
        {
          "@type": "Question",
          "name": "Does Petaloons deliver dog clothes for {{ breed_name }} across India?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, Petaloons delivers pan-India including Mumbai, Delhi, Bangalore, Chennai, Hyderabad and all major cities. Free shipping on orders above ₹999. Express delivery available in metro cities." }
        }
      ]
    }
  ]
}
</script>

<style>
  /* ══ Petaloons Breed Page — .pbr-* ══ */
  .pbr-wrap *, .pbr-wrap *::before, .pbr-wrap *::after { box-sizing: border-box; }
  .pbr-wrap {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #1a1a1a;
  }

  /* ── Hero ── */
  .pbr-hero {
    position: relative;
    background: linear-gradient(135deg, #6b2200 0%, #b84500 30%, #de7200 62%, #fea910 100%);
    padding: 72px 24px 88px;
    text-align: center;
    overflow: hidden;
  }
  .pbr-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='30' cy='30' r='3' fill='%23ffffff' fill-opacity='0.04'/%3E%3C/svg%3E");
  }
  .pbr-hero__breadcrumb {
    position: relative;
    font-size: 12px;
    color: rgba(255,255,255,.65);
    margin-bottom: 20px;
  }
  .pbr-hero__breadcrumb a { color: rgba(255,255,255,.8); text-decoration: none; }
  .pbr-hero__breadcrumb a:hover { color: #fff; }
  .pbr-hero__badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,.15);
    border: 1px solid rgba(255,255,255,.35);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 18px;
    border-radius: 30px;
    margin-bottom: 18px;
  }
  .pbr-hero__title {
    position: relative;
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    font-weight: 900;
    color: #fff;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin: 0 0 14px;
  }
  .pbr-hero__title span { color: #ffd438; }
  .pbr-hero__sub {
    position: relative;
    font-size: 1.05rem;
    color: rgba(255,255,255,.85);
    max-width: 560px;
    margin: 0 auto 32px;
    line-height: 1.65;
  }
  .pbr-hero__pills {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  .pbr-hero__pill {
    background: rgba(255,255,255,.18);
    border: 1px solid rgba(255,255,255,.35);
    color: #fff;
    padding: 9px 20px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: background .2s, border-color .2s;
  }
  .pbr-hero__pill:hover { background: rgba(255,255,255,.3); border-color: #fff; text-decoration: none; }
  .pbr-hero__stats {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
    border-top: 1px solid rgba(255,255,255,.18);
    padding-top: 32px;
  }
  .pbr-hero__stat {
    padding: 0 36px;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,.15);
  }
  .pbr-hero__stat:last-child { border-right: none; }
  .pbr-hero__stat-num {
    display: block;
    font-size: 1.9rem;
    font-weight: 900;
    color: #ffd438;
    line-height: 1;
  }
  .pbr-hero__stat-label {
    font-size: 11px;
    color: rgba(255,255,255,.7);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 4px;
    display: block;
  }
  @media (max-width: 600px) {
    .pbr-hero { padding: 56px 16px 64px; }
    .pbr-hero__stat { padding: 0 20px; }
    .pbr-hero__stat-num { font-size: 1.4rem; }
  }

  /* ── Section layout ── */
  .pbr-section { padding: 64px 24px; }
  .pbr-section--grey { background: #f8f6f3; }
  .pbr-container { max-width: 1100px; margin: 0 auto; }
  .pbr-section-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #b84500;
    margin-bottom: 10px;
  }
  .pbr-section-title {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 900;
    color: #1a1a1a;
    margin: 0 0 10px;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }
  .pbr-section-sub {
    font-size: .95rem;
    color: #666;
    max-width: 540px;
    line-height: 1.6;
    margin: 0 0 36px;
  }

  /* ── Breed profile card ── */
  .pbr-profile {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }
  .pbr-profile__card {
    background: #fff;
    border: 1px solid #e8e3dc;
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 2px 16px rgba(184,69,0,.07);
  }
  .pbr-profile__emoji {
    font-size: 3rem;
    margin-bottom: 12px;
    display: block;
  }
  .pbr-profile__name {
    font-size: 1.5rem;
    font-weight: 900;
    color: #b84500;
    margin: 0 0 8px;
  }
  .pbr-profile__blurb {
    font-size: .95rem;
    color: #555;
    line-height: 1.65;
    margin: 0 0 24px;
  }
  .pbr-profile__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .pbr-profile__stat {
    background: #fff8f0;
    border: 1px solid #f0d9c0;
    border-radius: 10px;
    padding: 14px 16px;
  }
  .pbr-profile__stat-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #b84500;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .pbr-profile__stat-val {
    font-size: 1rem;
    font-weight: 800;
    color: #1a1a1a;
  }
  .pbr-style-tips {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pbr-tip {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: #fff;
    border: 1px solid #e8e3dc;
    border-radius: 12px;
    padding: 18px 20px;
  }
  .pbr-tip__icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .pbr-tip__body {}
  .pbr-tip__title { font-size: .9rem; font-weight: 800; color: #1a1a1a; margin: 0 0 3px; }
  .pbr-tip__desc  { font-size: .85rem; color: #666; line-height: 1.5; margin: 0; }
  @media (max-width: 768px) {
    .pbr-profile { grid-template-columns: 1fr; }
  }

  /* ── Size guide ── */
  .pbr-size-guide { overflow-x: auto; }
  .pbr-size-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .9rem;
  }
  .pbr-size-table th {
    background: #b84500;
    color: #fff;
    padding: 12px 16px;
    text-align: left;
    font-weight: 700;
    font-size: .8rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pbr-size-table th:first-child { border-radius: 8px 0 0 0; }
  .pbr-size-table th:last-child  { border-radius: 0 8px 0 0; }
  .pbr-size-table td {
    padding: 13px 16px;
    border-bottom: 1px solid #ede8e1;
    color: #1a1a1a;
    white-space: nowrap;
  }
  .pbr-size-table tr:nth-child(even) td { background: #fdfaf7; }
  .pbr-size-table tr.pbr-size-table__highlight td {
    background: #fff8f0;
    font-weight: 700;
    color: #b84500;
  }
  .pbr-size-badge {
    display: inline-block;
    background: #fea910;
    color: #0f1117;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 20px;
    margin-left: 6px;
    vertical-align: middle;
    text-transform: uppercase;
    letter-spacing: .8px;
  }
  .pbr-size-note {
    margin-top: 14px;
    font-size: .82rem;
    color: #888;
    line-height: 1.55;
  }
  .pbr-size-note strong { color: #b84500; }

  /* ── Outfit category tabs ── */
  .pbr-outfit-tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .pbr-outfit-tab {
    padding: 10px 22px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    border: 2px solid #e0d6cc;
    background: #fff;
    color: #666;
    transition: all .18s;
    text-decoration: none;
  }
  .pbr-outfit-tab:hover,
  .pbr-outfit-tab--active {
    background: #b84500;
    border-color: #b84500;
    color: #fff;
    text-decoration: none;
  }

  /* ── Product grid ── */
  .pbr-prod-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) { .pbr-prod-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .pbr-prod-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }

  .pbr-card {
    background: #fff;
    border: 1px solid #ede8e1;
    border-radius: 14px;
    overflow: hidden;
    transition: box-shadow .2s, transform .2s;
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }
  .pbr-card:hover { box-shadow: 0 8px 28px rgba(184,69,0,.12); transform: translateY(-3px); text-decoration: none; }
  .pbr-card__img-wrap {
    position: relative;
    padding-top: 100%;
    background: #f8f5f0;
    overflow: hidden;
  }
  .pbr-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .4s;
  }
  .pbr-card:hover .pbr-card__img { transform: scale(1.05); }
  .pbr-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #b84500;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 20px;
    letter-spacing: .8px;
    text-transform: uppercase;
  }
  .pbr-card__body { padding: 14px 16px 18px; flex: 1; display: flex; flex-direction: column; }
  .pbr-card__title { font-size: .88rem; font-weight: 700; color: #1a1a1a; margin: 0 0 6px; line-height: 1.3; }
  .pbr-card__price { font-size: 1rem; font-weight: 900; color: #b84500; margin: auto 0 0; }
  .pbr-card__compare { font-size: .8rem; color: #aaa; text-decoration: line-through; margin-left: 6px; font-weight: 400; }
  .pbr-card__sizes {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .pbr-card__sz {
    font-size: 9px;
    font-weight: 700;
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 2px 5px;
    color: #777;
    text-transform: uppercase;
  }
  .pbr-view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 28px;
    padding: 13px 28px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 800;
    border: 2px solid #b84500;
    color: #b84500;
    text-decoration: none;
    transition: all .18s;
  }
  .pbr-view-all:hover { background: #b84500; color: #fff; text-decoration: none; }

  /* ── Occasion cards ── */
  .pbr-occasions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 700px) { .pbr-occasions { grid-template-columns: 1fr; } }
  .pbr-occ-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4/3;
    background: #1a1a1a;
    text-decoration: none;
    display: flex;
    align-items: flex-end;
  }
  .pbr-occ-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .pbr-occ-card--wedding::before { background: linear-gradient(160deg, #6b220044 0%, #b8450099 100%); }
  .pbr-occ-card--festival::before { background: linear-gradient(160deg, #1e3a8a44 0%, #0f111799 100%); }
  .pbr-occ-card--casual::before { background: linear-gradient(160deg, #1a4d3544 0%, #0d2d1f99 100%); }
  .pbr-occ-body {
    position: relative;
    z-index: 2;
    padding: 24px;
    width: 100%;
  }
  .pbr-occ-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255,255,255,.75);
    margin-bottom: 4px;
  }
  .pbr-occ-title { font-size: 1.15rem; font-weight: 900; color: #fff; margin: 0 0 6px; }
  .pbr-occ-link {
    font-size: 12px;
    color: #fea910;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: .5px;
  }
  .pbr-occ-emoji {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 2rem;
    z-index: 2;
  }

  /* ── FAQ ── */
  .pbr-faqs { display: flex; flex-direction: column; gap: 12px; max-width: 780px; }
  .pbr-faq {
    background: #fff;
    border: 1px solid #e8e3dc;
    border-radius: 12px;
    overflow: hidden;
  }
  .pbr-faq__q {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 20px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: .95rem;
    font-weight: 700;
    color: #1a1a1a;
    text-align: left;
    line-height: 1.4;
  }
  .pbr-faq__q:hover { color: #b84500; }
  .pbr-faq__icon { font-size: 1rem; flex-shrink: 0; color: #b84500; transition: transform .2s; }
  .pbr-faq__a {
    display: none;
    padding: 0 20px 18px;
    font-size: .9rem;
    color: #555;
    line-height: 1.65;
  }
  .pbr-faq--open .pbr-faq__a { display: block; }
  .pbr-faq--open .pbr-faq__icon { transform: rotate(45deg); }

  /* ── Related breeds ── */
  .pbr-related {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }
  @media (max-width: 768px) { .pbr-related { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 480px) { .pbr-related { grid-template-columns: repeat(2, 1fr); } }
  .pbr-rel-card {
    background: #fff;
    border: 1px solid #ede8e1;
    border-radius: 14px;
    padding: 20px 12px;
    text-align: center;
    text-decoration: none;
    transition: box-shadow .2s, border-color .2s;
  }
  .pbr-rel-card:hover { box-shadow: 0 4px 16px rgba(184,69,0,.1); border-color: #b84500; text-decoration: none; }
  .pbr-rel-card__emoji { font-size: 2rem; display: block; margin-bottom: 8px; }
  .pbr-rel-card__name { font-size: .8rem; font-weight: 700; color: #1a1a1a; line-height: 1.3; }
  .pbr-rel-card__size { font-size: .72rem; color: #b84500; font-weight: 600; margin-top: 2px; }

  /* ── Sticky CTA bar ── */
  .pbr-sticky {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 999;
    background: #0f1117;
    border-top: 2px solid #b84500;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 -4px 24px rgba(0,0,0,.25);
    transform: translateY(100%);
    transition: transform .3s ease;
  }
  .pbr-sticky--visible { transform: translateY(0); }
  .pbr-sticky__text { font-size: .88rem; color: rgba(255,255,255,.8); font-weight: 500; }
  .pbr-sticky__text strong { color: #fea910; font-weight: 800; }
  .pbr-sticky__btns { display: flex; gap: 10px; flex-shrink: 0; }
  .pbr-sticky__btn {
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition: opacity .15s;
  }
  .pbr-sticky__btn:hover { opacity: .85; text-decoration: none; }
  .pbr-sticky__btn--gold { background: #fea910; color: #0f1117; }
  .pbr-sticky__btn--outline { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,.4); }
  @media (max-width: 520px) {
    .pbr-sticky__text { display: none; }
    .pbr-sticky__btns { width: 100%; }
    .pbr-sticky__btn { flex: 1; text-align: center; }
  }
</style>

<div class="pbr-wrap">

  <!-- ══ HERO ══ -->
  <section class="pbr-hero">
    <p class="pbr-hero__breadcrumb">
      <a href="/">Home</a> &rsaquo;
      <a href="/pages/dog-breed-guides">Breed Guides</a> &rsaquo;
      {{ breed_name }}
    </p>
    <div class="pbr-hero__badge">{{ breed_emoji }} Breed Guide</div>
    <h1 class="pbr-hero__title">
      Dog Clothes for<br><span>{{ breed_name }}</span>
    </h1>
    <p class="pbr-hero__sub">{{ breed_blurb }}</p>
    <div class="pbr-hero__pills">
      <a href="#lehengas"  class="pbr-hero__pill">👗 Dog Lehenga</a>
