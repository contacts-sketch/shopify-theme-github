    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type":"ListItem","position":1,"name":"Home","item":"{{ shop.url }}"},
        {"@type":"ListItem","position":2,"name":"Dog Clothes","item":"{{ shop.url }}/collections/all"},
        {"@type":"ListItem","position":3,"name":"{{ breed_name }} Clothes","item":"{{ shop.url }}/pages/{{ page.handle }}"}
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {"@type":"Question","name":"What size dog clothes for {{ breed_name }}?","acceptedAnswer":{"@type":"Answer","text":"Most {{ breed_name }}s wear {{ typical_size }}. Always measure chest girth first. Petaloons offers free sizing help on WhatsApp at +91 86250 75493."}},
      {"@type":"Question","name":"Best dog outfits for {{ breed_name }} in India?","acceptedAnswer":{"@type":"Answer","text":"Best outfits for {{ breed_name }}s: {{ best_outfits }}. Available at Petaloons with free shipping across India."}},
      {"@type":"Question","name":"Where to buy {{ breed_name }} dog clothes in India?","acceptedAnswer":{"@type":"Answer","text":"Petaloons is India's #1 dog fashion brand. Shop {{ breed_name }} outfits at petaloons.com with free shipping on orders above Rs.999."}}
    ]
  }
]
</script>

<script>
  document.querySelectorAll('.pbreed-faq__q').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var ans = btn.nextElementSibling, isOpen = btn.classList.contains('open');
      btn.closest('.pbreed-faq__inner').querySelectorAll('.pbreed-faq__q').forEach(function(b){ b.classList.remove('open'); b.setAttribute('aria-expanded','false'); });
      btn.closest('.pbreed-faq__inner').querySelectorAll('.pbreed-faq__a').forEach(function(a){ a.classList.remove('open'); });
      if (!isOpen) { btn.classList.add('open'); btn.setAttribute('aria-expanded','true'); ans.classList.add('open'); }
    });
  });
</script>

