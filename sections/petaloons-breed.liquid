<!-- ══ STICKY CTA ══ -->
<div class="pbr-sticky" id="pbr-sticky" aria-hidden="true">
  <p class="pbr-sticky__text">Dressing your <strong>{{ breed_name }}</strong>? Find the perfect outfit.</p>
  <div class="pbr-sticky__btns">
    <a href="/collections/dog-lehengas"  class="pbr-sticky__btn pbr-sticky__btn--outline">👗 Lehenga</a>
    <a href="/collections/dog-t-shirts"  class="pbr-sticky__btn pbr-sticky__btn--gold">Shop Now</a>
  </div>
</div>

<script>
(function () {
  // FAQ accordion
  document.querySelectorAll('.pbr-faq__q').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var faq = btn.closest('.pbr-faq');
      var open = faq.classList.contains('pbr-faq--open');
      document.querySelectorAll('.pbr-faq--open').forEach(function (el) { el.classList.remove('pbr-faq--open'); el.querySelector('.pbr-faq__q').setAttribute('aria-expanded','false'); });
      if (!open) { faq.classList.add('pbr-faq--open'); btn.setAttribute('aria-expanded','true'); }
    });
  });

  // Sticky CTA on scroll
  var sticky = document.getElementById('pbr-sticky');
  if (sticky) {
    window.addEventListener('scroll', function () {
      if (window.scrollY > 400) {
        sticky.classList.add('pbr-sticky--visible');
        sticky.removeAttribute('aria-hidden');
      } else {
        sticky.classList.remove('pbr-sticky--visible');
        sticky.setAttribute('aria-hidden','true');
      }
    }, { passive: true });
  }
})();
</script>

{% schema %}
{
  "name": "Breed Landing Page",
  "tag": "section",
  "class": "pbr-section-wrapper",
  "settings": [
    {
      "type": "header",
