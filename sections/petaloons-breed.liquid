{% comment %}
  Petaloons Breed Landing Pages
  Auto-adapts per breed based on page handle
  CSS scope: .pbreed-*
  Handles: dog-clothes-shih-tzu | dog-clothes-pug | dog-clothes-labrador
           dog-clothes-golden-retriever | dog-clothes-german-shepherd
           dog-clothes-pomeranian | dog-clothes-beagle | dog-clothes-husky
           dog-clothes-dachshund | dog-clothes-indie
{% endcomment %}

{%- liquid
  assign bh = page.handle | downcase

  assign breed_name   = 'Dog'
  assign breed_emoji  = '🐶'
  assign hero_color   = '#5a1d00'
  assign typical_size = 'S – M'
  assign coat_type    = 'Short'
  assign key_tip      = 'Measure chest girth first'
  assign best_outfits = 'Bandanas, cotton tees, ethnic kurtas'
  assign avoid        = 'Heavy layered fabrics'
  assign size_note    = ''

  if bh contains 'shih-tzu'
    assign breed_name   = 'Shih Tzu'
    assign breed_emoji  = '🦁'
    assign hero_color   = '#3b0764'
    assign typical_size = 'XS – S'
    assign coat_type    = 'Long, silky, flowing'
    assign key_tip      = "Shih Tzus are barrel-chested — always size by chest girth, not weight alone"
    assign best_outfits = 'Lehengas, embroidered sherwanis, floral dresses, silk kurtas'
    assign avoid        = "Anything with small buttons or loose threads that can catch in the long coat"
    assign size_note    = "Most adult Shih Tzus wear XS or S. Measure chest girth — it is often wider than weight suggests."

  elsif bh contains 'pug'
    assign breed_name   = 'Pug'
    assign breed_emoji  = '🐾'
    assign hero_color   = '#7c2d12'
    assign typical_size = 'XS – S'
    assign coat_type    = 'Short, fine'
    assign key_tip      = "Pugs overheat very easily — keep outdoor outfit time under 10 minutes in summer. Natural fabrics only."
    assign best_outfits = 'Lightweight cotton tees, bandanas, light cotton kurtas (indoors only)'
    assign avoid        = "Anything that restricts the chest or breathing. Never use tight collars with Pugs."
    assign size_note    = "Most adult Pugs wear S. Measure chest AND neck — Pugs have wide necks relative to weight."

  elsif bh contains 'labrador'
    assign breed_name   = 'Labrador'
    assign breed_emoji  = '🐕'
    assign hero_color   = '#1e3a5f'
    assign typical_size = 'L – XL'
    assign coat_type    = 'Short, dense double coat'
    assign key_tip      = "Labs are barrel-chested — if between sizes, always size up. Size by chest girth, never weight alone."
    assign best_outfits = 'Bold cotton tees, bandanas, kurtas and sherwanis for occasions'
    assign avoid        = 'Restrictive armhole designs — Labs need full shoulder mobility'
    assign size_note    = "Most adult Labs wear L or XL. Female Labs are typically one size smaller than males."

  elsif bh contains 'golden-retriever'
    assign breed_name   = 'Golden Retriever'
    assign breed_emoji  = '🌟'
    assign hero_color   = '#78350f'
    assign typical_size = 'L – XL'
    assign coat_type    = 'Long, flowing double coat'
    assign key_tip      = "Avoid fabrics that create static or mat the beautiful flowing coat. Smooth cotton and silk blends work best."
    assign best_outfits = 'Rich embroidered sherwanis and kurtas, jewel-tone bandanas'
    assign avoid        = 'Heavy synthetic fabrics that trap heat under the double coat'
    assign size_note    = "Most Goldens wear L or XL. Measure chest and back length — the flowing coat can add apparent bulk."

  elsif bh contains 'german-shepherd'
    assign breed_name   = 'German Shepherd'
    assign breed_emoji  = '🛡️'
    assign hero_color   = '#1a2e1a'
    assign typical_size = 'L – XL'
    assign coat_type    = 'Medium double coat'
    assign key_tip      = "Keep designs clean and structured — GSDs carry themselves with natural authority. Let the breed shine."
    assign best_outfits = 'Clean bandanas, structured kurtas, sports harness vests'
    assign avoid        = 'Overly fussy or frilly designs that clash with the breed character'
    assign size_note    = "Most adult GSDs wear L (female) or XL (male). Always measure chest girth individually."

  elsif bh contains 'pomeranian'
    assign breed_name   = 'Pomeranian'
    assign breed_emoji  = '🧸'
    assign hero_color   = '#92400e'
    assign typical_size = 'XS'
    assign coat_type    = 'Thick, fluffy double coat'
    assign key_tip      = "Choose lightweight fabrics that frame the fluffy coat without hiding or flattening it."
    assign best_outfits = 'Frilly dresses, princess lehengas, sparkly tees, floral bandanas'
    assign avoid        = 'Heavy thick fabrics that flatten the coat or cause overheating in summer'
    assign size_note    = "Most Pomeranians wear XS. Measure chest girth carefully — do not size by weight alone."

  elsif bh contains 'beagle'
    assign breed_name   = 'Beagle'
    assign breed_emoji  = '🔍'
    assign hero_color   = '#1e3a5f'
    assign typical_size = 'S – M'
    assign coat_type    = 'Short, dense'
    assign key_tip      = "Beagles love to run and sniff — choose non-restrictive, washable outfits that survive outdoor adventures."
    assign best_outfits = 'Plaid cotton tees, bright bandanas, casual sports vests'
    assign avoid        = 'Floor-length outfits that restrict movement during outdoor activity'
    assign size_note    = "Most Beagles wear S or M. Check chest girth — Beagles are stocky relative to their height."

  elsif bh contains 'husky'
    assign breed_name   = 'Husky'
    assign breed_emoji  = '❄️'
    assign hero_color   = '#0f172a'
    assign typical_size = 'M – L'
    assign coat_type    = 'Thick double coat'
    assign key_tip      = "Huskies already have a built-in fur coat — keep clothing minimal, light, and for short durations only."
    assign best_outfits = 'Simple bandanas, monochrome tees for photos only, mesh vests'
    assign avoid        = 'Heavy or thick outfits — Huskies overheat very easily, especially in Indian summers'
    assign size_note    = "Most Huskies wear M or L. Female Huskies are typically S or M."

  elsif bh contains 'dachshund'
    assign breed_name   = 'Dachshund'
    assign breed_emoji  = '🌭'
    assign hero_color   = '#7c2d12'
    assign typical_size = 'XS – S'
    assign coat_type    = 'Short (standard) or long'
    assign key_tip      = "Dachshunds need extra back-length in outfits — their bodies are much longer than their weight suggests."
    assign best_outfits = 'Stretchy cotton tees, bandanas, simple tube dresses'
    assign avoid        = 'Tight leg holes — Dachshunds have very short legs with limited clearance'
    assign size_note    = "Measure back length carefully. Dachshunds are much longer than their weight suggests — standard sizing may not work."

  elsif bh contains 'indie'
    assign breed_name   = 'Indie Dog'
    assign breed_emoji  = '🇮🇳'
    assign hero_color   = '#4a1942'
    assign typical_size = 'S – L (varies widely)'
    assign coat_type    = 'Short to medium'
    assign key_tip      = "Indies come in all shapes and sizes — always measure fresh as body shapes vary greatly between individuals."
    assign best_outfits = 'Cotton kurtas, bandanas, sports tees — ethnic collection looks especially stunning on Indies'
    assign avoid        = 'Nothing — Indies look amazing in everything!'
    assign size_note    = "No standard size for Indie dogs. Measure chest, neck, and back length every time you order."
  endif
-%}

<style>
  .pbreed-wrap * { box-sizing: border-box; }
  .pbreed-wrap { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1a1a1a; }

  /* ── Hero ─────────────────────────────────── */
  .pbreed-hero {
    position: relative;
    background: linear-gradient(135deg, {{ hero_color }} 0%, #b84500 55%, #de7200 100%);
    padding: 72px 24px 96px;
    text-align: center; overflow: hidden;
  }
  .pbreed-hero::before {
    content: ''; position: absolute; inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Ccircle cx='30' cy='30' r='4'/%3E%3C/g%3E%3C/svg%3E");
  }
  .pbreed-hero__breadcrumb { position: relative; font-size: 13px; color: rgba(255,255,255,.65); margin-bottom: 20px; }
  .pbreed-hero__breadcrumb a { color: rgba(255,255,255,.8); text-decoration: none; }
  .pbreed-hero__breadcrumb a:hover { color: #fff; }
  .pbreed-hero__badge {
    position: relative; display: inline-block;
    background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.3);
    color: #fff; font-size: 12px; font-weight: 700; letter-spacing: 1.5px;
    text-transform: uppercase; padding: 6px 20px; border-radius: 30px; margin-bottom: 18px;
  }
  .pbreed-hero__title {
    position: relative;
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    font-weight: 900; color: #fff; margin: 0 0 14px; line-height: 1.1; letter-spacing: -1.5px;
  }
  .pbreed-hero__title span { color: #fea910; }
  .pbreed-hero__sub { position: relative; font-size: 1.05rem; color: rgba(255,255,255,.85); max-width: 560px; margin: 0 auto 32px; line-height: 1.65; }
  .pbreed-hero__btns { position: relative; display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; margin-bottom: 44px; }
  .pbreed-hero__btn {
    padding: 14px 30px; border-radius: 10px; font-size: 15px; font-weight: 800;
    text-decoration: none; transition: all .2s; display: inline-flex; align-items: center; gap: 8px;
  }
  .pbreed-hero__btn:hover { transform: translateY(-2px); opacity: .92; text-decoration: none; }
  .pbreed-hero__btn--gold { background: #fea910; color: #1a1a1a; }
  .pbreed-hero__btn--outline { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.4); }
  .pbreed-hero__btn--outline:hover { background: rgba(255,255,255,.1); }
  .pbreed-hero__chips { position: relative; display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
  .pbreed-hero__chip {
    background: rgba(255,255,255,.13); border: 1px solid rgba(255,255,255,.25);
    color: #fff; font-size: 13px; font-weight: 600; padding: 7px 16px; border-radius: 30px;
  }
  .pbreed-hero__wave { position: absolute; bottom: -2px; left: 0; width: 100%; line-height: 0; }

  /* ── Trust strip ──────────────────────────── */
  .pbreed-trust { background: #fff; padding: 0 24px; }
  .pbreed-trust__inner {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px;
    transform: translateY(-40px);
  }
  .pbreed-trust-card {
    background: #fff; border-radius: 16px; padding: 22px 18px;
    box-shadow: 0 6px 32px rgba(0,0,0,.09); border: 1.5px solid #f0e8e0;
    text-align: center; transition: transform .2s, border-color .2s;
  }
  .pbreed-trust-card:hover { transform: translateY(-4px); border-color: #b84500; }
  .pbreed-trust-card__icon { font-size: 26px; margin-bottom: 8px; display: block; }
  .pbreed-trust-card__val { font-size: 1.1rem; font-weight: 900; color: #b84500; margin-bottom: 4px; }
  .pbreed-trust-card__label { font-size: 12px; color: #666; }

  /* ── Main layout ──────────────────────────── */
  .pbreed-body { background: #fdf9f6; padding: 0 24px 72px; }
  .pbreed-body__inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 360px; gap: 48px; align-items: start; }

  .pbreed-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #b84500; margin-bottom: 10px; }
  .pbreed-h2 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 900; color: #1a1a1a; margin: 0 0 18px; line-height: 1.2; letter-spacing: -.5px; }
  .pbreed-intro-text { font-size: 15px; color: #555; line-height: 1.8; margin-bottom: 24px; }

  .pbreed-highlights { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 24px; }
  .pbreed-highlight { background: #fff; border-radius: 12px; padding: 16px; border: 1.5px solid #f0e8e0; }
  .pbreed-highlight__label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; color: #b84500; margin-bottom: 5px; }
  .pbreed-highlight__val { font-size: 14px; font-weight: 600; color: #1a1a1a; line-height: 1.4; }

  .pbreed-tip {
    background: #fff8f0; border-left: 4px solid #b84500; border-radius: 0 12px 12px 0;
    padding: 16px 20px; margin-bottom: 28px; font-size: 14px; color: #555; line-height: 1.6;
  }
  .pbreed-tip strong { color: #b84500; }

  .pbreed-outfit-list { display: flex; flex-direction: column; gap: 12px; }
  .pbreed-outfit-item {
    background: #fff; border-radius: 12px; padding: 16px 18px;
    border: 1.5px solid #f0e8e0; display: flex; align-items: center; gap: 14px;
    text-decoration: none; color: inherit; transition: all .2s;
  }
  .pbreed-outfit-item:hover { border-color: #b84500; transform: translateX(4px); text-decoration: none; }
  .pbreed-outfit-item__icon { font-size: 24px; flex-shrink: 0; }
  .pbreed-outfit-item__name { font-size: 14.5px; font-weight: 700; color: #1a1a1a; margin-bottom: 3px; }
  .pbreed-outfit-item__desc { font-size: 12.5px; color: #777; }
  .pbreed-outfit-item__arrow { margin-left: auto; color: #b84500; font-weight: 700; flex-shrink: 0; }

  /* ── Sidebar ──────────────────────────────── */
  .pbreed-sidebar { display: flex; flex-direction: column; gap: 20px; position: sticky; top: 100px; }
  .pbreed-card { background: #fff; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,.07); border: 1px solid #f0e8e0; }
  .pbreed-card__title { font-size: 14px; font-weight: 800; color: #1a1a1a; margin: 0 0 16px; padding-bottom: 12px; border-bottom: 2px solid #f0e8e0; }
  .pbreed-size-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .pbreed-size-table thead tr { background: linear-gradient(90deg, #b84500, #de7200); color: #fff; }
  .pbreed-size-table th { padding: 9px 10px; text-align: left; font-weight: 700; }
  .pbreed-size-table tbody tr { border-bottom: 1px solid #f0e8e0; }
  .pbreed-size-table tbody tr:last-child { border-bottom: none; }
  .pbreed-size-table td { padding: 9px 10px; color: #444; }
  .pbreed-size-table td:first-child { font-weight: 700; color: #b84500; }
  .pbreed-size-note { font-size: 12px; color: #888; margin-top: 12px; line-height: 1.5; font-style: italic; }

  .pbreed-wa-card { background: linear-gradient(135deg, #b84500, #de7200); border-radius: 16px; padding: 24px; color: #fff; text-align: center; }
  .pbreed-wa-card__icon { font-size: 32px; margin-bottom: 10px; }
  .pbreed-wa-card__title { font-size: 15px; font-weight: 800; margin-bottom: 8px; }
  .pbreed-wa-card__text { font-size: 13px; opacity: .9; margin-bottom: 16px; line-height: 1.5; }
  .pbreed-wa-card__btn { display: block; background: #fff; color: #b84500; text-decoration: none; font-weight: 800; font-size: 13.5px; padding: 11px 20px; border-radius: 30px; transition: opacity .2s; margin-bottom: 8px; }
  .pbreed-wa-card__btn:hover { opacity: .9; text-decoration: none; }
  .pbreed-wa-card__wa { display: block; background: #25d366; color: #fff; text-decoration: none; font-weight: 800; font-size: 13px; padding: 10px 20px; border-radius: 30px; transition: opacity .2s; }
  .pbreed-wa-card__wa:hover { opacity: .9; text-decoration: none; }

  /* ── Collections grid ────────────────────── */
  .pbreed-collections { background: #fff; padding: 72px 24px; border-top: 1px solid #f0e8e0; }
  .pbreed-collections__inner { max-width: 1100px; margin: 0 auto; }
  .pbreed-col-head { text-align: center; margin-bottom: 44px; }
  .pbreed-col-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .pbreed-col-item {
    background: #fdf9f6; border-radius: 16px; padding: 26px 20px;
    border: 1.5px solid #f0e8e0; text-align: center;
    text-decoration: none; color: inherit; display: block; transition: all .22s;
  }
  .pbreed-col-item:hover { transform: translateY(-5px); box-shadow: 0 12px 36px rgba(184,69,0,.14); border-color: #b84500; text-decoration: none; }
  .pbreed-col-item__icon { font-size: 32px; margin-bottom: 10px; display: block; }
  .pbreed-col-item__name { font-size: .95rem; font-weight: 800; color: #1a1a1a; margin-bottom: 5px; }
  .pbreed-col-item__sub { font-size: 12.5px; color: #666; line-height: 1.4; margin-bottom: 12px; }
  .pbreed-col-item__link { font-size: 12.5px; font-weight: 700; color: #b84500; }

  /* ── FAQ ─────────────────────────────────── */
  .pbreed-faq { background: #fdf9f6; padding: 72px 24px; border-top: 1px solid #f0e8e0; }
  .pbreed-faq__inner { max-width: 780px; margin: 0 auto; }
  .pbreed-faq__item { border-bottom: 1px solid #f0e8e0; }
  .pbreed-faq__item:last-child { border-bottom: none; }
  .pbreed-faq__q {
    width: 100%; background: none; border: none; text-align: left;
    padding: 18px 0; font-size: 15px; font-weight: 700; color: #1a1a1a;
    cursor: pointer; display: flex; justify-content: space-between; align-items: center;
    gap: 16px; font-family: inherit; transition: color .2s;
  }
  .pbreed-faq__q:hover, .pbreed-faq__q.open { color: #b84500; }
  .pbreed-faq__chevron { width: 22px; height: 22px; border: 2px solid currentColor; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform .25s; font-size: 12px; }
  .pbreed-faq__q.open .pbreed-faq__chevron { transform: rotate(180deg); }
  .pbreed-faq__a { max-height: 0; overflow: hidden; transition: max-height .3s ease, padding .3s ease; font-size: 14px; color: #555; line-height: 1.75; }
  .pbreed-faq__a.open { max-height: 300px; padding-bottom: 18px; }
  .pbreed-faq__a a { color: #b84500; font-weight: 600; text-decoration: none; }

  /* ── CTA ─────────────────────────────────── */
  .pbreed-cta { background: linear-gradient(135deg, {{ hero_color }}, #b84500); padding: 64px 24px; text-align: center; }
  .pbreed-cta__inner { max-width: 580px; margin: 0 auto; }
  .pbreed-cta__title { font-size: clamp(1.6rem, 3.5vw, 2.2rem); font-weight: 900; color: #fff; margin: 0 0 12px; }
  .pbreed-cta__sub { font-size: 15px; color: rgba(255,255,255,.85); margin-bottom: 28px; line-height: 1.6; }
  .pbreed-cta__btns { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
  .pbreed-cta__btn { padding: 14px 28px; border-radius: 10px; font-size: 15px; font-weight: 800; text-decoration: none; transition: all .2s; display: inline-flex; align-items: center; gap: 8px; }
  .pbreed-cta__btn:hover { transform: translateY(-2px); opacity: .92; text-decoration: none; }
  .pbreed-cta__btn--gold { background: #fea910; color: #1a1a1a; }
  .pbreed-cta__btn--wa { background: #25d366; color: #fff; }

  /* ── Responsive ─────────────────────────── */
  @media (max-width: 989px) {
    .pbreed-trust__inner { grid-template-columns: repeat(2, 1fr); transform: translateY(-28px); }
    .pbreed-body__inner { grid-template-columns: 1fr; }
    .pbreed-sidebar { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .pbreed-col-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 749px) {
    .pbreed-hero { padding: 52px 20px 76px; }
    .pbreed-trust__inner { grid-template-columns: repeat(2, 1fr); }
    .pbreed-highlights { grid-template-columns: 1fr; }
    .pbreed-sidebar { grid-template-columns: 1fr; }
    .pbreed-col-grid { grid-template-columns: 1fr; }
    .pbreed-cta__btns { flex-direction: column; align-items: center; }
  }
</style>

