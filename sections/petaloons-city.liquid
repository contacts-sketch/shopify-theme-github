{% comment %}
  Petaloons City Landing Pages
  Auto-adapts content based on page handle (mumbai / delhi / bangalore)
  CSS scope: .pcity-*
  Handles: dog-clothes-mumbai | dog-clothes-delhi | dog-clothes-bangalore
{% endcomment %}

{%- liquid
  assign city_handle = page.handle | downcase
  assign city_name   = 'India'
  assign city_sub    = 'Delivering pan-India'
  assign city_hero_color = '#5a1d00'
  assign city_emoji  = '🇮🇳'
  assign delivery_time = '4–7 days'
  assign delivery_badge = 'Pan-India Shipping'
  assign zone_label  = 'Standard Zone'

  if city_handle contains 'mumbai'
    assign city_name   = 'Mumbai'
    assign city_emoji  = '🌊'
    assign city_sub    = "India's most dog-friendly city"
    assign city_hero_color = '#0c2a4a'
    assign delivery_time = '1–3 days'
    assign delivery_badge = 'Express Delivery Available'
    assign zone_label  = 'Metro Zone — Fastest Delivery'
  elsif city_handle contains 'delhi'
    assign city_name   = 'Delhi'
    assign city_emoji  = '🏛️'
    assign city_sub    = "The capital city's favourite dog fashion brand"
    assign city_hero_color = '#2d0a40'
    assign delivery_time = '1–3 days'
    assign delivery_badge = 'Express Delivery Available'
    assign zone_label  = 'Metro Zone — Fastest Delivery'
  elsif city_handle contains 'bangalore'
    assign city_name   = 'Bangalore'
    assign city_emoji  = '🌿'
    assign city_sub    = 'The pet-loving capital of India'
    assign city_hero_color = '#0a3020'
    assign delivery_time = '1–3 days'
    assign delivery_badge = 'Express Delivery Available'
    assign zone_label  = 'Metro Zone — Fastest Delivery'
  elsif city_handle contains 'hyderabad'
    assign city_name   = 'Hyderabad'
    assign city_emoji  = '💎'
    assign city_sub    = 'The City of Nawabs loves its dogs in style'
    assign city_hero_color = '#2a1a00'
    assign delivery_time = '2–4 days'
    assign delivery_badge = 'Fast Delivery'
    assign zone_label  = 'Metro Zone'
  elsif city_handle contains 'chennai'
    assign city_name   = 'Chennai'
    assign city_emoji  = '🌊'
    assign city_sub    = "South India's dog fashion destination"
    assign city_hero_color = '#1a0a2e'
    assign delivery_time = '2–4 days'
    assign delivery_badge = 'Fast Delivery'
    assign zone_label  = 'Metro Zone'
  elsif city_handle contains 'pune'
    assign city_name   = 'Pune'
    assign city_emoji  = '🎓'
    assign city_sub    = 'Oxford of the East loves stylish dogs'
    assign city_hero_color = '#1a2a0a'
    assign delivery_time = '2–4 days'
    assign delivery_badge = 'Fast Delivery'
    assign zone_label  = 'Metro Zone'
  endif
-%}

<style>
  .pcity-wrap * { box-sizing: border-box; }
  .pcity-wrap { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1a1a1a; }

  /* ── Hero ─────────────────────────────── */
  .pcity-hero {
    position: relative;
    background: linear-gradient(135deg, {{ city_hero_color }} 0%, #b84500 60%, #de7200 100%);
    padding: 72px 24px 96px;
    text-align: center;
    overflow: hidden;
  }
  .pcity-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Ccircle cx='30' cy='30' r='4'/%3E%3C/g%3E%3C/svg%3E");
  }
  .pcity-hero__breadcrumb {
    position: relative;
    font-size: 13px; color: rgba(255,255,255,.65); margin-bottom: 20px;
  }
  .pcity-hero__breadcrumb a { color: rgba(255,255,255,.8); text-decoration: none; }
  .pcity-hero__breadcrumb a:hover { color: #fff; }
  .pcity-hero__badge {
    position: relative;
    display: inline-block;
    background: rgba(255,255,255,.15);
    border: 1px solid rgba(255,255,255,.3);
    color: #fff;
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 6px 20px; border-radius: 30px; margin-bottom: 18px;
  }
  .pcity-hero__title {
    position: relative;
    font-size: clamp(2rem, 5.5vw, 3.6rem);
    font-weight: 900; color: #fff;
    margin: 0 0 14px; line-height: 1.1; letter-spacing: -1.5px;
  }
  .pcity-hero__title span { color: #fea910; }
  .pcity-hero__sub {
    position: relative;
    font-size: 1.05rem; color: rgba(255,255,255,.85);
    max-width: 560px; margin: 0 auto 32px; line-height: 1.65;
  }
  .pcity-hero__btns {
    position: relative;
    display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; margin-bottom: 48px;
  }
  .pcity-hero__btn {
    padding: 14px 30px; border-radius: 10px; font-size: 15px; font-weight: 800;
    text-decoration: none; transition: all .2s; display: inline-flex; align-items: center; gap: 8px;
  }
  .pcity-hero__btn:hover { transform: translateY(-2px); opacity: .92; text-decoration: none; }
  .pcity-hero__btn--primary { background: #fea910; color: #1a1a1a; }
  .pcity-hero__btn--outline { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.4); }
  .pcity-hero__btn--outline:hover { background: rgba(255,255,255,.1); }
  .pcity-hero__stats {
    position: relative;
    display: flex; justify-content: center; gap: 0;
    border-top: 1px solid rgba(255,255,255,.12); padding-top: 36px;
  }
  .pcity-hero__stat {
    padding: 0 36px; text-align: center;
    border-right: 1px solid rgba(255,255,255,.12);
  }
  .pcity-hero__stat:last-child { border-right: none; }
  .pcity-hero__stat-val { font-size: 1.9rem; font-weight: 900; color: #fea910; display: block; line-height: 1; margin-bottom: 5px; }
  .pcity-hero__stat-label { font-size: 12px; color: rgba(255,255,255,.6); font-weight: 500; }
  .pcity-hero__wave { position: absolute; bottom: -2px; left: 0; width: 100%; line-height: 0; }

  /* ── Trust Bar ──────────────────────────── */
  .pcity-trust {
    background: #fff; padding: 0 24px;
  }
  .pcity-trust__inner {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
    transform: translateY(-40px);
  }
  .pcity-trust-card {
    background: #fff; border-radius: 16px; padding: 22px 18px;
    box-shadow: 0 6px 32px rgba(0,0,0,.09);
    border: 1.5px solid #f0e8e0;
    text-align: center;
    transition: transform .2s, border-color .2s;
  }
  .pcity-trust-card:hover { transform: translateY(-4px); border-color: #b84500; }
  .pcity-trust-card__icon { font-size: 28px; margin-bottom: 8px; display: block; }
  .pcity-trust-card__val { font-size: 1.15rem; font-weight: 900; color: #b84500; margin-bottom: 4px; }
  .pcity-trust-card__label { font-size: 12px; color: #666; font-weight: 500; }

  /* ── Intro ──────────────────────────────── */
  .pcity-intro {
    background: #fdf9f6;
    padding: 0 24px 72px;
  }
  .pcity-intro__inner {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 440px; gap: 56px; align-items: center;
  }
  .pcity-intro__eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #b84500; margin-bottom: 12px; }
  .pcity-intro__title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 900; color: #1a1a1a; margin: 0 0 18px; line-height: 1.2; letter-spacing: -.5px; }
  .pcity-intro__body { font-size: 15px; color: #555; line-height: 1.8; margin-bottom: 24px; }
  .pcity-intro__list { list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-direction: column; gap: 12px; }
  .pcity-intro__list li { font-size: 14.5px; color: #444; display: flex; align-items: center; gap: 10px; }
  .pcity-intro__list li::before { content: '✓'; color: #b84500; font-weight: 800; font-size: 16px; flex-shrink: 0; }
  .pcity-intro__cta {
    display: inline-flex; align-items: center; gap: 8px;
    background: linear-gradient(90deg, #b84500, #de7200);
    color: #fff; text-decoration: none; font-weight: 800; font-size: 14.5px;
    padding: 13px 26px; border-radius: 10px; transition: opacity .2s;
  }
  .pcity-intro__cta:hover { opacity: .9; text-decoration: none; }
  .pcity-delivery-card {
    background: #fff; border-radius: 20px; padding: 32px;
    box-shadow: 0 6px 32px rgba(0,0,0,.08); border: 1.5px solid #f0e8e0;
  }
  .pcity-delivery-card__title { font-size: 1rem; font-weight: 800; color: #1a1a1a; margin: 0 0 20px; padding-bottom: 14px; border-bottom: 2px solid #f0e8e0; }
  .pcity-delivery-row {
    display: flex; align-items: center; gap: 14px;
    padding: 12px 0; border-bottom: 1px solid #f5ede6;
  }
  .pcity-delivery-row:last-child { border-bottom: none; }
  .pcity-delivery-row__icon { font-size: 22px; flex-shrink: 0; }
  .pcity-delivery-row__label { font-size: 12px; color: #888; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
  .pcity-delivery-row__val { font-size: 14.5px; font-weight: 700; color: #1a1a1a; }
  .pcity-delivery-badge {
    margin-top: 20px;
    background: linear-gradient(90deg, #b84500, #de7200);
    border-radius: 10px; padding: 14px 18px;
    color: #fff; font-size: 13.5px; font-weight: 700;
    display: flex; align-items: center; gap: 10px;
  }

  /* ── Collections ────────────────────────── */
  .pcity-collections {
    background: #fff; padding: 72px 24px;
    border-top: 1px solid #f0e8e0;
  }
  .pcity-collections__inner { max-width: 1100px; margin: 0 auto; }
  .pcity-section-head { text-align: center; margin-bottom: 48px; }
  .pcity-section-head__eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #b84500; margin-bottom: 10px; }
  .pcity-section-head__title { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 900; color: #1a1a1a; margin: 0; letter-spacing: -.5px; }
  .pcity-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
  }
  .pcity-col-card {
    background: #fdf9f6; border-radius: 16px; padding: 28px 22px;
    border: 1.5px solid #f0e8e0; text-align: center;
    text-decoration: none; color: inherit;
    transition: all .22s; display: block;
  }
  .pcity-col-card:hover { transform: translateY(-5px); box-shadow: 0 12px 36px rgba(184,69,0,.14); border-color: #b84500; text-decoration: none; }
  .pcity-col-card__icon { font-size: 36px; margin-bottom: 12px; display: block; }
  .pcity-col-card__name { font-size: 1rem; font-weight: 800; color: #1a1a1a; margin-bottom: 6px; }
  .pcity-col-card__desc { font-size: 13px; color: #666; line-height: 1.5; margin-bottom: 14px; }
  .pcity-col-card__link { font-size: 13px; font-weight: 700; color: #b84500; }

  /* ── City Spotlight ─────────────────────── */
  .pcity-spotlight {
    background: #0f1117; padding: 72px 24px;
  }
  .pcity-spotlight__inner { max-width: 1100px; margin: 0 auto; }
  .pcity-spotlight__title { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 900; color: #fff; margin: 0 0 12px; }
  .pcity-spotlight__sub { font-size: 15px; color: rgba(255,255,255,.65); margin-bottom: 40px; line-height: 1.6; max-width: 680px; }
  .pcity-spots {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
  }
  .pcity-spot {
    background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
    border-radius: 14px; padding: 22px 20px;
    transition: border-color .2s, background .2s;
  }
  .pcity-spot:hover { border-color: #b84500; background: rgba(184,69,0,.1); }
  .pcity-spot__icon { font-size: 26px; margin-bottom: 10px; display: block; }
  .pcity-spot__name { font-size: 14.5px; font-weight: 800; color: #fff; margin-bottom: 5px; }
  .pcity-spot__desc { font-size: 13px; color: rgba(255,255,255,.55); line-height: 1.5; }

  /* ── FAQ ────────────────────────────────── */
  .pcity-faq { background: #fdf9f6; padding: 72px 24px; border-top: 1px solid #f0e8e0; }
  .pcity-faq__inner { max-width: 780px; margin: 0 auto; }
  .pcity-faq__item { border-bottom: 1px solid #f0e8e0; }
  .pcity-faq__item:last-child { border-bottom: none; }
  .pcity-faq__q {
    width: 100%; background: none; border: none; text-align: left;
    padding: 18px 0; font-size: 15px; font-weight: 700; color: #1a1a1a;
    cursor: pointer; display: flex; justify-content: space-between; align-items: center;
    gap: 16px; font-family: inherit; transition: color .2s;
  }
  .pcity-faq__q:hover, .pcity-faq__q.open { color: #b84500; }
  .pcity-faq__chevron { width: 22px; height: 22px; border: 2px solid currentColor; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform .25s; font-size: 12px; }
  .pcity-faq__q.open .pcity-faq__chevron { transform: rotate(180deg); }
  .pcity-faq__a { max-height: 0; overflow: hidden; transition: max-height .3s ease, padding .3s ease; font-size: 14px; color: #555; line-height: 1.75; }
  .pcity-faq__a.open { max-height: 300px; padding-bottom: 18px; }
  .pcity-faq__a a { color: #b84500; font-weight: 600; text-decoration: none; }

  /* ── CTA ────────────────────────────────── */
  .pcity-cta {
    background: linear-gradient(135deg, {{ city_hero_color }}, #b84500);
    padding: 64px 24px; text-align: center;
  }
  .pcity-cta__inner { max-width: 580px; margin: 0 auto; }
  .pcity-cta__title { font-size: clamp(1.6rem, 3.5vw, 2.2rem); font-weight: 900; color: #fff; margin: 0 0 12px; }
  .pcity-cta__sub { font-size: 15px; color: rgba(255,255,255,.85); margin-bottom: 28px; line-height: 1.6; }
  .pcity-cta__btns { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
  .pcity-cta__btn { padding: 14px 28px; border-radius: 10px; font-size: 15px; font-weight: 800; text-decoration: none; transition: all .2s; display: inline-flex; align-items: center; gap: 8px; }
  .pcity-cta__btn:hover { transform: translateY(-2px); opacity: .92; text-decoration: none; }
  .pcity-cta__btn--primary { background: #fea910; color: #1a1a1a; }
  .pcity-cta__btn--wa { background: #25d366; color: #fff; }

  /* ── Responsive ─────────────────────────── */
  @media (max-width: 989px) {
    .pcity-trust__inner { grid-template-columns: repeat(2, 1fr); transform: translateY(-28px); }
    .pcity-intro__inner { grid-template-columns: 1fr; }
    .pcity-grid { grid-template-columns: repeat(2, 1fr); }
    .pcity-spots { grid-template-columns: repeat(2, 1fr); }
    .pcity-hero__stat { padding: 0 18px; }
  }
  @media (max-width: 749px) {
    .pcity-hero { padding: 52px 20px 76px; }
    .pcity-trust__inner { grid-template-columns: repeat(2, 1fr); }
    .pcity-hero__stats { flex-wrap: wrap; }
    .pcity-hero__stat { width: 50%; border-right: none; border-bottom: 1px solid rgba(255,255,255,.1); padding: 14px 0; }
    .pcity-grid { grid-template-columns: 1fr; }
    .pcity-spots { grid-template-columns: 1fr; }
    .pcity-cta__btns { flex-direction: column; align-items: center; }
  }
</style>

<div class="pcity-wrap">

  <!-- ═══ HERO ════════════════════════════════ -->
  <div class="pcity-hero">
    <nav class="pcity-hero__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a> ›
      <a href="/collections/all">Dog Clothes</a> ›
      <span>{{ city_name }}</span>
    </nav>
    <div class="pcity-hero__badge">{{ city_emoji }} {{ city_name }} | Free Shipping Above ₹999</div>
    <h1 class="pcity-hero__title">
      Dog Clothes in <span>{{ city_name }}</span><br>
      Delivered to Your Door
    </h1>
    <p class="pcity-hero__sub">
      Shop India's #1 dog fashion brand from the comfort of your {{ city_name }} home. Premium lehengas, sherwanis, bandanas, and more — delivered in {{ delivery_time }}.
    </p>
    <div class="pcity-hero__btns">
      <a href="/collections/all" class="pcity-hero__btn pcity-hero__btn--primary">🛍️ Shop Now</a>
      <a href="https://wa.me/918625075493?text=Hi%20Petaloons!%20I%27m%20from%20{{ city_name }}%20and%20want%20to%20order." class="pcity-hero__btn pcity-hero__btn--outline" target="_blank" rel="noopener">💬 WhatsApp Order</a>
    </div>
    <div class="pcity-hero__stats">
      <div class="pcity-hero__stat">
        <span class="pcity-hero__stat-val">{{ delivery_time }}</span>
        <span class="pcity-hero__stat-label">Delivery to {{ city_name }}</span>
      </div>
      <div class="pcity-hero__stat">
        <span class="pcity-hero__stat-val">FREE</span>
        <span class="pcity-hero__stat-label">Shipping above ₹999</span>
      </div>
      <div class="pcity-hero__stat">
        <span class="pcity-hero__stat-val">10K+</span>
        <span class="pcity-hero__stat-label">Happy Customers</span>
      </div>
      <div class="pcity-hero__stat">
        <span class="pcity-hero__stat-val">4.8★</span>
        <span class="pcity-hero__stat-label">Average Rating</span>
      </div>
    </div>
    <div class="pcity-hero__wave">
      <svg viewBox="0 0 1440 48" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0 48L1440 48L1440 12C1200 44 960 4 720 20C480 36 240 0 0 12L0 48Z" fill="#fdf9f6"/>
      </svg>
    </div>
  </div>

  <!-- ═══ TRUST CARDS ══════════════════════════ -->
  <div class="pcity-trust">
    <div class="pcity-trust__inner">
      <div class="pcity-trust-card">
        <span class="pcity-trust-card__icon">🚀</span>
        <div class="pcity-trust-card__val">{{ delivery_time }}</div>
        <div class="pcity-trust-card__label">Delivery to {{ city_name }}</div>
      </div>
      <div class="pcity-trust-card">
        <span class="pcity-trust-card__icon">🎁</span>
        <div class="pcity-trust-card__val">Free Shipping</div>
        <div class="pcity-trust-card__label">On orders above ₹999</div>
      </div>
      <div class="pcity-trust-card">
        <span class="pcity-trust-card__icon">🔄</span>
        <div class="pcity-trust-card__val">7-Day Returns</div>
        <div class="pcity-trust-card__label">Hassle-free policy</div>
      </div>
      <div class="pcity-trust-card">
        <span class="pcity-trust-card__icon">🇮🇳</span>
        <div class="pcity-trust-card__val">Made in India</div>
        <div class="pcity-trust-card__label">Handcrafted with love</div>
      </div>
    </div>
  </div>

  <!-- ═══ INTRO + DELIVERY ══════════════════════ -->
  <div class="pcity-intro">
    <div class="pcity-intro__inner">
      <div>
        <div class="pcity-intro__eyebrow">Why {{ city_name }} Dog Parents Choose Petaloons</div>
        <h2 class="pcity-intro__title">
          India's #1 Dog Fashion Brand,<br>Now at Your {{ city_name }} Doorstep
        </h2>

        {%- if city_handle contains 'mumbai' -%}
        <p class="pcity-intro__body">
          Mumbai's dog parent community is one of the most passionate in India. From Bandra to Powai, from Juhu to Thane — Petaloons outfits are spotted at dog parks, beach walks, and birthday pawties all across the city. We've served thousands of Mumbai dog parents with premium ethnic wear, casual tees, and festival outfits, all delivered express to your door.
        </p>
        <ul class="pcity-intro__list">
          <li>Express delivery in 1–3 days to all Mumbai pin codes</li>
          <li>Free shipping on orders above ₹999 — no exceptions</li>
          <li>Perfect for Ganesh Chaturthi, Diwali, and Mumbai's vibrant festival calendar</li>
          <li>COD available across Mumbai, Navi Mumbai, and Thane</li>
          <li>Returns pickup directly from your door</li>
        </ul>
        {%- elsif city_handle contains 'delhi' -%}
        <p class="pcity-intro__body">
          Delhi's dog parents are among the most style-conscious in India. From South Delhi's upscale parks to Noida's booming pet community and Gurugram's corporate dog parents — Petaloons delivers premium dog fashion across the entire NCR region. Whether it's a Diwali lehenga in Defence Colony or a sherwani for a Gurgaon wedding, we've got Delhi covered.
        </p>
        <ul class="pcity-intro__list">
          <li>Express delivery 1–3 days to Delhi, Noida, Gurugram, Faridabad, Ghaziabad</li>
          <li>Free shipping on orders above ₹999 across Delhi NCR</li>
          <li>Ideal for Delhi's wedding season, Diwali, and Eid celebrations</li>
          <li>COD available across all Delhi NCR pin codes</li>
          <li>Hassle-free 7-day returns with doorstep pickup</li>
        </ul>
        {%- elsif city_handle contains 'bangalore' -%}
        <p class="pcity-intro__body">
          Bangalore is India's most pet-friendly city and has one of the country's most engaged dog parent communities. From Indiranagar to Koramangala, from Whitefield to Jayanagar — Petaloons is beloved across Bangalore's vibrant dog culture. With India's largest collection of dog ethnic wear, casual outfits, and accessories, we ship to every Bangalore pin code in 1–3 days.
        </p>
        <ul class="pcity-intro__list">
          <li>Express delivery 1–3 days across all Bangalore pin codes</li>
          <li>Free shipping on orders above ₹999</li>
          <li>Perfect for Bangalore's growing dog café culture and community events</li>
          <li>COD available across Bangalore Urban and Bangalore Rural</li>
          <li>Easy 7-day returns with doorstep pickup</li>
        </ul>
        {%- else -%}
        <p class="pcity-intro__body">
          {{ city_name }}'s dog parents deserve India's best dog fashion brand. Petaloons delivers premium dog ethnic wear, casual outfits, bandanas, harnesses, and accessories across {{ city_name }} with fast shipping and free delivery above ₹999. Join thousands of happy dog parents across India who trust Petaloons for every occasion.
        </p>
        <ul class="pcity-intro__list">
          <li>Fast delivery to all {{ city_name }} pin codes</li>
          <li>Free shipping on orders above ₹999</li>
          <li>Premium quality handcrafted outfits</li>
          <li>COD available at most pin codes</li>
          <li>7-day hassle-free returns</li>
