<script>
  document.querySelectorAll('.pcity-faq__q').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var ans = btn.nextElementSibling;
      var isOpen = btn.classList.contains('open');
      btn.closest('.pcity-faq__inner').querySelectorAll('.pcity-faq__q').forEach(function(b){ b.classList.remove('open'); b.setAttribute('aria-expanded','false'); });
      btn.closest('.pcity-faq__inner').querySelectorAll('.pcity-faq__a').forEach(function(a){ a.classList.remove('open'); });
      if (!isOpen) { btn.classList.add('open'); btn.setAttribute('aria-expanded','true'); ans.classList.add('open'); }
    });
  });
</script>

