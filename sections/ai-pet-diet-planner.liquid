  const FLOW_STEPS = [
    { key: 'name',     ask: "Hi! I'm Petaloons AI 🐾 Let's build a personalised diet plan for your dog. What's your dog's name?" },
    { key: 'breed',    ask: (d) => `Lovely! How old is ${d.name} and what breed are they? (e.g. "2 years, Golden Retriever")` },
    { key: 'weight',   ask: (d) => `Got it! What's ${d.name}'s current weight? (e.g. "12 kg")` },
    { key: 'activity', ask: (d) => `How active is ${d.name}? (Low / Moderate / High)` },
    { key: 'diet',     ask: (d) => `Does ${d.name} eat Vegetarian, Non-Vegetarian, or Both?` },
    { key: 'allergies',ask: () => 'Any known food allergies or intolerances? (Type "none" if not)' },
    { key: 'concerns', ask: () => 'Any health concerns I should know about? (e.g. joint issues, obesity, sensitive stomach — or type "none")' },
  ];

  let state = { step: -1, petData: {}, chatTopic: null };

  const chatWindow  = document.getElementById('pdp-chat-window');
  const typingEl    = document.getElementById('pdp-typing');
  const inputForm   = document.getElementById('pdp-input-form');
  const inputEl     = document.getElementById('pdp-user-input');
  const startBtn    = document.getElementById('pdp-start-btn');
  const restartBtn  = document.getElementById('pdp-restart-btn');
  const chipsEl     = document.getElementById('pdp-chips');

  function scrollDown() {
    chatWindow.scrollTo({ top: chatWindow.scrollHeight, behavior: 'smooth' });
  }

  function addMessage(role, html) {
    const wrap = document.createElement('div');
    wrap.className = `pdp-msg pdp-msg--${role}`;

    if (role === 'bot') {
      wrap.innerHTML = `
        <div class="pdp-msg__avatar" aria-hidden="true">🐾</div>
        <div class="pdp-msg__bubble">${html}</div>`;
    } else {
      wrap.innerHTML = `
        <div class="pdp-msg__bubble">${escHtml(html)}</div>`;
    }

    chatWindow.appendChild(wrap);
    scrollDown();
  }

  function showTyping(ms) {
    typingEl.hidden = false;
    scrollDown();
    return new Promise(res => setTimeout(() => { typingEl.hidden = true; res(); }, ms));
  }

  async function botSay(html, delay = 900) {
    await showTyping(delay);
    addMessage('bot', html);
    scrollDown();
  }

  function escHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  async function startChat(topic) {
    state = { step: 0, petData: {}, chatTopic: topic || null };
    chatWindow.innerHTML = '';
    chipsEl.style.display = 'none';
    inputEl.disabled = false;
    inputEl.focus();

    const topicIntro = {
      puppy:    'You selected <strong>Puppy Diet Plan</strong>. Let me ask a few quick questions! 🐶',
      weight:   'You selected <strong>Weight Loss Diet</strong>. Let me personalise a plan! ⚖️',
      homemade: 'You selected <strong>Homemade Food</strong>. Great choice! Let me customise it. 🍳',
      veg:      'You selected <strong>Vegetarian Diet</strong>. Perfect — let\'s find tasty veg options! 🥦',
      senior:   'You selected <strong>Senior Dog Diet</strong>. Gentle nutrition for golden years! 🐕',
      allergy:  'You selected <strong>Food Allergy Help</strong>. Let\'s figure out safe foods! 🌿',
    };

    if (topic && topicIntro[topic]) {
      await botSay(topicIntro[topic], 600);
    }

    await askCurrentStep();
  }

  async function askCurrentStep() {
    const step = FLOW_STEPS[state.step];
    if (!step) return;
    const question = typeof step.ask === 'function' ? step.ask(state.petData) : step.ask;
    await botSay(question, 700);
    inputEl.placeholder = 'Type your answer…';
  }

  async function handleUserInput(text) {
    if (!text.trim()) return;
    addMessage('user', text);
    inputEl.value = '';

    if (state.step < 0) {
      await startChat();
      return;
    }

    const stepKey = FLOW_STEPS[state.step]?.key;
    if (stepKey) {
      state.petData[stepKey] = text.trim();
    }

    state.step++;

    if (state.step < FLOW_STEPS.length) {
      await askCurrentStep();
    } else {
      await generateAndShowPlan();
    }
  }

  async function generateAndShowPlan() {
    inputEl.disabled = true;
    inputEl.placeholder = 'Plan generated! Start a new chat below.';

    await botSay(`Great! Let me build ${escHtml(state.petData.name || 'your dog')}'s personalised diet plan…`, 600);
    await showTyping(2200);

    /* ---------------------------------------------------------------
       OPENAI API INTEGRATION POINT
       Replace the call below with a fetch to your server-side proxy:

       const res = await fetch('/apps/diet-planner/suggest', {
         method: 'POST',
         headers: { 'Content-Type': 'application/json' },
         body: JSON.stringify(state.petData),
       });
       const plan = await res.json();

       Then render plan.mealTiming, plan.quantity, etc. from the response.
       --------------------------------------------------------------- */
    const plan = generateDummyPlan(state.petData, state.chatTopic);

    addMessage('bot', buildPlanHTML(state.petData, plan));
    scrollDown();
  }

  /* -----------------------------------------------------------------
     DUMMY PLAN GENERATOR
     Produces a realistic-feeling response based on pet details.
     Replace with real AI output when API is integrated.
     ----------------------------------------------------------------- */
  function generateDummyPlan(d, topic) {
    const name     = d.name   || 'your dog';
    const breed    = d.breed  || 'your dog';
    const weightKg = parseFloat(d.weight) || 10;
    const activity = (d.activity || 'moderate').toLowerCase();
    const isVeg    = /veg/i.test(d.diet || '') && !/non/i.test(d.diet || '');
    const isPuppy  = topic === 'puppy' || /pup|month|4 month|6 month/i.test(d.breed || '');
    const isSenior = topic === 'senior' || /8 year|9 year|10 year|11 year|12 year|senior/i.test(d.breed || '');

    const multiplier = activity === 'high' ? 1.25 : activity === 'low' ? 0.80 : 1.0;
    const dailyCalories = Math.round(weightKg * 70 * multiplier);
    const mealCount = isPuppy ? 4 : isSenior ? 3 : 2;
    const caloriesPerMeal = Math.round(dailyCalories / mealCount);

    const vegFoods    = ['boiled rice', 'boiled sweet potato', 'plain curd (unseasoned)', 'paneer (unseasoned)', 'boiled lentils', 'carrots', 'pumpkin'];
    const nonVegFoods = ['boiled chicken breast', 'boiled eggs', 'fish (salmon/rohu)', 'lean mutton'];
    const proteins    = isVeg ? vegFoods.slice(0, 3) : nonVegFoods.slice(0, 3);
    const veggies     = ['carrots', 'green beans', 'pumpkin', 'spinach (small amount)'];

    const treats = isVeg
      ? ['banana slices', 'apple pieces (no seeds)', 'carrot sticks', 'plain rice cakes']
      : ['boiled chicken strips', 'carrot sticks', 'plain rice cakes', 'apple pieces (no seeds)'];

    return {
      calories: dailyCalories,
      caloriesPerMeal,
      mealCount,
      proteins,
      veggies,
      treats,
      weightKg,
      isVeg,
      isPuppy,
      isSenior,
      activity,
    };
  }

  function buildPlanHTML(d, plan) {
    const name = escHtml(d.name || 'Your dog');

    return `
<div class="pdp-result-card">
  <p style="font-size:15px;font-weight:700;margin:0 0 10px;">🎉 Here's ${name}'s personalised diet plan!</p>

  <div class="pdp-result-item">
    <div class="pdp-result-item__title">⏰ Meal Timing</div>
    <div class="pdp-result-item__body">
      Feed <strong>${plan.mealCount} meals per day</strong>${plan.isPuppy ? ' (puppies need more frequent meals for steady energy)' : plan.isSenior ? ' (senior dogs digest better with smaller, frequent meals)' : ''}.
      <ul>
        ${plan.mealCount === 4
          ? '<li>7:00 AM — Morning meal</li><li>12:00 PM — Midday meal</li><li>5:00 PM — Evening meal</li><li>9:00 PM — Light dinner</li>'
          : plan.mealCount === 3
          ? '<li>7:30 AM — Breakfast</li><li>1:00 PM — Lunch</li><li>7:00 PM — Dinner</li>'
          : '<li>8:00 AM — Breakfast</li><li>7:00 PM — Dinner</li>'}
      </ul>
    </div>
  </div>

  <div class="pdp-result-item">
    <div class="pdp-result-item__title">🍽️ Food Quantity</div>
    <div class="pdp-result-item__body">
      Estimated daily calories: <strong>~${plan.calories} kcal</strong> (~${plan.caloriesPerMeal} kcal per meal).<br/>
      For a <strong>${plan.weightKg} kg</strong> dog with <strong>${plan.activity}</strong> activity:
      <ul>
        <li>Protein: ~${Math.round(plan.weightKg * 6)}g per meal</li>
        <li>Carbs (rice/sweet potato): ~${Math.round(plan.weightKg * 8)}g per meal</li>
        <li>Veggies: 2–3 tbsp per meal</li>
      </ul>
      <em style="font-size:12px;color:#888;">Adjust by ±10% based on weight trends over 2 weeks.</em>
    </div>
  </div>

  <div class="pdp-result-item">
    <div class="pdp-result-item__title">✅ Safe Foods for ${name}</div>
    <div class="pdp-result-item__body">
      <strong>Proteins:</strong> ${plan.proteins.join(', ')}<br/>
      <strong>Veggies:</strong> ${plan.veggies.join(', ')}<br/>
      <strong>Avoid:</strong> onion, garlic, grapes, raisins, chocolate, xylitol, macadamia nuts
    </div>
  </div>

  <div class="pdp-result-item">
    <div class="pdp-result-item__title">🦴 Treat Recommendations</div>
    <div class="pdp-result-item__body">
      Treats should be &lt;10% of daily calories (~${Math.round(plan.calories * 0.1)} kcal).<br/>
      Safe options: ${plan.treats.join(', ')}.
    </div>
  </div>

  <div class="pdp-result-item">
    <div class="pdp-result-item__title">💧 Water Intake</div>
    <div class="pdp-result-item__body">
      Target: <strong>~${Math.round(plan.weightKg * 50)}–${Math.round(plan.weightKg * 60)} ml/day</strong> of fresh, clean water.<br/>
      ${plan.activity === 'high' ? 'High activity dogs lose more water — ensure access after every play session.' : 'Refresh the bowl twice daily. Dehydration can cause serious complications.'}
    </div>
  </div>

  <div class="pdp-vet-note">
    <span style="font-size:18px">🩺</span>
    <span><strong>When to consult a vet:</strong> If ${name} shows vomiting, diarrhoea, lethargy, sudden weight change, or refuses food for &gt;24 hrs, visit a vet immediately. Annual diet reviews are recommended.</span>
  </div>
</div>`;
  }

  /* ----- Event Wiring ----- */

  startBtn.addEventListener('click', () => {
    document.getElementById('pdp-chat-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
    setTimeout(() => startChat(), 400);
  });

  restartBtn.addEventListener('click', () => {
    state = { step: -1, petData: {}, chatTopic: null };
    chatWindow.innerHTML = '';
    chipsEl.style.display = 'flex';
    inputEl.disabled = false;
    inputEl.placeholder = 'Type your answer or choose a chip above…';
    inputEl.value = '';
  });

  inputForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = inputEl.value.trim();
    if (!text || inputEl.disabled) return;
    if (state.step === -1) {
      startChat();
    } else {
      handleUserInput(text);
    }
  });

  chipsEl.addEventListener('click', (e) => {
    const chip = e.target.closest('.pdp-chip');
    if (!chip) return;
    startChat(chip.dataset.topic);
  });

  /* Initial welcome message on page load */
  (async function init() {
    await botSay('👋 Welcome to <strong>Petaloons AI Pet Diet Planner!</strong><br/>Choose a topic chip or type to start building a personalised diet plan for your dog.', 500);
  })();

})();
</script>

