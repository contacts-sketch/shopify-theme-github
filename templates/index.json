ock;\n  box-shadow: 0 16px 40px rgba(0,0,0,0.12);\n}\n\n@media (max-width: 900px) {\n  .pet-vet-wrap {\n    grid-template-columns: 1fr;\n    padding: 30px;\n  }\n\n  .pet-vet-image img {\n    height: 320px;\n  }\n}\n\n@media (max-width: 520px) {\n  .pet-vet-banner {\n    padding: 35px 14px;\n  }\n\n  .pet-vet-wrap {\n    padding: 24px;\n    border-radius: 24px;\n  }\n\n  .pet-vet-actions {\n    flex-direction: column;\n  }\n\n  .pet-vet-btn {\n    width: 100%;\n  }\n\n  .pet-vet-image img {\n    height: 260px;\n  }\n}\n</style>","color_scheme":"","padding_top":40,"padding_bottom":52}},"177705806477bb273f":{"type":"_blocks","blocks":{"ai_gen_block_6faaff4_Y8UcM8":{"type":"ai_gen_block_6faaff4","settings":{"heading":"Why Choose Petaloons","heading_alignment":"center","heading_size":32,"heading_color":"#121212","heading_spacing":40,"columns_desktop":5,"columns_mobile":"2","item_alignment":"center","item_spacing":20,"item_padding":15,"item_border_radius":8,"desktop_width_percent":100,"section_padding":60,"background_color":"#ffffff","item_background_color":"#f3f3f3","text_color":"#121212","icon_size":48,"icon_spacing":15,"text_size":16,"text_weight":"500","show_item_1":true,"icon_1":"🧵","text_1":"Premium Fabric","show_item_2":true,"icon_2":"🐶","text_2":"Perfect Fit for All Breeds","show_item_3":true,"icon_3":"🚚","text_3":"Fast Delivery Across India","show_item_4":true,"icon_4":"💰","text_4":"Affordable Pricing","show_item_5":true,"icon_5":"❤️","text_5":"Made for Comfort"},"blocks":{}}},"block_order":["ai_gen_block_6faaff4_Y8UcM8"],"settings":{}},"featured_blog_HbDd7Y":{"type":"featured-blog","settings":{"blog":"news","post_limit":4,"heading":"Blog posts","heading_size":"h2","columns_desktop":4,"show_view_all":true,"show_image":true,"show_date":false,"show_author":false,"color_scheme":"","padding_top":36,"padding_bottom":36}},"172495409965b2edcb":{"type":"apps","blocks":{"instafeed_app_block_CykMQH":{"type":"shopify://apps/instafeed/blocks/app-block/c447db20-095d-4a10-972