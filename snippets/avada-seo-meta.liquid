{%- if request.page_type == 'article' -%}
{%- unless avada_seo_ovr_article_ids contains article.id -%}
{%- capture avada_seo_meta_title -%}{{ article.title }} | Petaloons Pet Care Blog{%- endcapture -%}
{%- capture avada_seo_meta_description -%}{%- if article.excerpt != blank -%}{{ article.excerpt | strip_html | strip | truncate: 155 }}{%- else -%}{{ article.content | strip_html | strip | truncate: 155 }}{%- endif -%}{%- endcapture -%}
{%- endunless -%}
{%- endif -%}
{%- if avada_seo_meta_title -%}
{%- assign seo_title = avada_seo_meta_title | strip_html | strip -%}
